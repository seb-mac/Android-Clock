<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/hour_container_start"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.02"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/second_container_end"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.98"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/hour_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toStartOf="@+id/minute_container"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/hour_container_start"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/time_element_width">
        <com.android.deskclock.common.ui.temporalpicker.gastown.TimeElementTextInputLayout
            android:id="@+id/hour_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/time_element_text_input_height"
            app:element_type="hour"
            style="@style/TimeElementTextInputStyle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:id="@+id/hour_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_hours_static"
            android:importantForAccessibility="no"
            style="@style/TimeElementLabelStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/minute_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/time_element_text_margin"
        android:layout_marginEnd="@dimen/time_element_text_margin"
        app:layout_constraintEnd_toStartOf="@+id/second_container"
        app:layout_constraintStart_toEndOf="@+id/hour_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.android.deskclock.common.ui.temporalpicker.gastown.TimeElementTextInputLayout
            android:id="@+id/minute_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/time_element_text_input_height"
            app:element_type="minute"
            style="@style/TimeElementTextInputStyle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:id="@+id/minute_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_minutes_static"
            android:importantForAccessibility="no"
            style="@style/TimeElementLabelStyle"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/second_container"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constraintEnd_toEndOf="@+id/second_container_end"
        app:layout_constraintStart_toEndOf="@+id/minute_container"
        app:layout_constraintTop_toTopOf="parent">
        <com.android.deskclock.common.ui.temporalpicker.gastown.TimeElementTextInputLayout
            android:id="@+id/second_input"
            android:layout_width="match_parent"
            android:layout_height="@dimen/time_element_text_input_height"
            app:element_type="second"
            style="@style/TimeElementTextInputStyle"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:id="@+id/label_seconds_static"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/label_seconds_static"
            android:importantForAccessibility="no"
            style="@style/TimeElementLabelStyle"/>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
