<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="96dp"
        android:text="@string/gastown_stopwatch_reset_button_text"
        app:layout_constraintEnd_toEndOf="@+id/reset_button_end"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/GastownStopwatchLapResetButtonStyle"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/reset_button_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.18"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_stop_button_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.29"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_stop_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="136dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/start_stop_button_end"
        app:layout_constraintStart_toStartOf="@+id/start_stop_button_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/GastownStopwatchButtonTextStyleBase"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_stop_button_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.71"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/lap_button_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.82"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lap_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:minHeight="96dp"
        android:text="@string/gastown_stopwatch_lap_button_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="@+id/lap_button_start"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/GastownStopwatchLapResetButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
