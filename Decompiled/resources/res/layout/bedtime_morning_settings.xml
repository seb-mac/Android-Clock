<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bedtime_onboarding_settings_container"
    android:paddingBottom="8dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include
        android:id="@+id/preference_sunrise"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/bedtime_preference_view"/>
    <include
        android:id="@+id/preference_ringtone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/preference_sunrise"
        layout="@layout/bedtime_preference_view"/>
    <include
        android:id="@+id/preference_vibrate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/preference_ringtone"
        layout="@layout/bedtime_preference_view"/>
    <include
        android:id="@+id/preference_weather_brief"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@+id/preference_vibrate"
        layout="@layout/bedtime_preference_view"/>
    <TextView
        android:textAppearance="@style/TextAppearance.Body"
        android:gravity="start|center_vertical"
        android:id="@+id/workflow_label"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:drawablePadding="20dp"
        android:textAlignment="viewStart"
        android:paddingStart="20dp"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_min="64dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/preference_weather_brief"/>
</androidx.constraintlayout.widget.ConstraintLayout>
