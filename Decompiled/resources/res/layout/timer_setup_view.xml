<?xml version="1.0" encoding="utf-8"?>
<com.android.deskclock.timer.TimerSetupView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_view_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_view_start_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_display_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_display_start_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_display_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_display_end_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_view_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_view_end_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/setup_digits_start"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/setup_digits_start_vertical_guideline_fraction"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/setup_digits_end"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/setup_digits_end_vertical_guideline_fraction"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/timer_setup_time_top"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_time_top_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/timer_setup_time_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_time_bottom_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/timer_setup_digit_bottom"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="@fraction/timer_setup_digit_bottom_percent"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/timer_setup_time"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:textDirection="ltr"
        app:paddingRatio="0.26"
        style="@style/TimerSetupTime"/>
    <include
        android:id="@+id/timer_setup_digits"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintDimensionRatio="3:4"
        app:layout_constraintHeight_max="420dp"
        app:layout_constraintWidth_max="315dp"
        layout="@layout/timer_setup_digits"
        style="@style/TimerSetupDigits"/>
    <include
        android:id="@+id/timer_setup_control_buttons_group"
        android:layout_width="0dp"
        android:layout_height="0dp"
        layout="@layout/timer_setup_control_buttons_group"
        style="@style/TimerSetupControlGroupButtons"/>
</com.android.deskclock.timer.TimerSetupView>
