<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:id="@+id/activity_remoteviews_configure"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <TextView
        android:textAppearance="?attr/textAppearanceHeadline4"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textview_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/remoteviews_title_top_padding"
        android:layout_marginBottom="@dimen/remoteviews_title_top_padding"/>
    <TextView
        android:gravity="center_horizontal"
        android:layout_gravity="center_horizontal"
        android:id="@+id/textview_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/remoteviews_subtitle_vertical_padding"
        android:layout_marginBottom="@dimen/remoteviews_subtitle_vertical_padding"
        android:layout_marginStart="@dimen/remoteviews_subtitle_horizontal_padding"
        android:layout_marginEnd="@dimen/remoteviews_subtitle_horizontal_padding"/>
    <Button
        android:layout_gravity="center_horizontal"
        android:id="@+id/button_subtitle"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/remoteviews_subtitle_vertical_padding"
        android:layout_marginBottom="@dimen/remoteviews_subtitle_vertical_padding"
        android:layout_marginStart="@dimen/remoteviews_subtitle_horizontal_padding"
        android:layout_marginEnd="@dimen/remoteviews_subtitle_horizontal_padding"/>
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">
        <android.support.v7.widget.RecyclerView
            android:layout_gravity="center"
            android:id="@+id/recyclerview_remoteviews"
            android:background="@drawable/background_recyclerview"
            android:paddingTop="@dimen/remoteviews_item_margin_top_bottom"
            android:paddingBottom="@dimen/remoteviews_item_margin_top_bottom"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:layout_width="@dimen/remoteviews_recyclerview_width"
            android:layout_height="@dimen/remoteviews_recyclerview_height"
            android:layout_margin="16dp"
            android:paddingStart="@dimen/remoteviews_item_margin_start_end"
            android:paddingEnd="@dimen/remoteviews_item_margin_start_end"
            android:clipToOutline="true"/>
    </FrameLayout>
</LinearLayout>
