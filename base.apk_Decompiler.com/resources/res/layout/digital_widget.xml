<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:id="@android:id/background"
    android:background="@drawable/digital_stadium_background"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:backgroundTint="?attr/appWidgetBackgroundTint"
    android:clipToOutline="true">
    <TextView
        android:textAppearance="?attr/appWidgetTextAppearanceLabel"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:format12Hour="@string/abbrev_wday_month_day_no_year"
        android:format24Hour="@string/abbrev_wday_month_day_no_year"/>
    <TextClock
        android:textAppearance="?attr/appWidgetTextAppearancePrimary"
        android:ellipsize="none"
        android:layout_gravity="center"
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:format12Hour="@string/lock_screen_12_hour_format"
        android:format24Hour="@string/lock_screen_24_hour_format"/>
    <LinearLayout
        android:layout_gravity="top|center_horizontal"
        android:id="@+id/alarm_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <android.widget.ImageView
            android:layout_gravity="center"
            android:id="@+id/alarm_icon_no_shadow"
            android:visibility="?attr/appWidgetAlarmIconNoShadowVisibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tab_alarm_white_24dp"
            android:scaleType="fitCenter"
            android:tint="?attr/appWidgetLabelTint"
            android:importantForAccessibility="no"/>
        <android.widget.ImageView
            android:layout_gravity="center"
            android:id="@+id/alarm_icon_with_shadow"
            android:visibility="?attr/appWidgetAlarmIconWithShadowVisibility"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_tab_alarm_white_24dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"/>
        <TextView
            android:textAppearance="?attr/appWidgetTextAppearanceLabel"
            android:ellipsize="none"
            android:layout_gravity="center"
            android:id="@+id/alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
