<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/calendar_card_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/bedtime_card_guidelines"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cross_profile_layout"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toTopOf="parent">
        <include layout="@layout/bedtime_card_guidelines"/>
        <ImageView
            android:id="@+id/cross_profile_image"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginTop="4dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="@+id/cross_profile_title"
            app:layout_constraintEnd_toStartOf="@+id/start_guide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/cross_profile_title"
            app:srcCompat="@drawable/quantum_gm_ic_enterprise_vd_theme_24"
            app:tint="?attr/colorOnSurface"
            app:tintMode="src_in"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="start|center_vertical"
            android:id="@+id/cross_profile_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/calendar_cross_profile_title"
            android:fontFamily="@font/google_sans_medium_compat"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="start"
            android:id="@+id/cross_profile_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/calendar_cross_profile_permission"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toBottomOf="@+id/cross_profile_title"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/button_flow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/bedtime_button_margin_top"
            app:constraint_referenced_ids="cross_profile_cancel,cross_profile_confirm"
            app:flow_horizontalBias="1"
            app:flow_horizontalGap="22dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toBottomOf="@+id/cross_profile_description"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorAccent"
            android:id="@+id/cross_profile_cancel"
            android:background="?attr/selectableItemBackground"
            android:padding="13dp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/consent_no_thanks"
            android:fontFamily="@font/google_sans_medium_compat"/>
        <Button
            android:layout_gravity="end"
            android:id="@+id/cross_profile_confirm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/calendar_cross_profile_permission_request"/>
        <View
            android:background="?attr/colorOutline"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hairline_size"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="@dimen/bedtime_calendar_end_margin"
            app:layout_constraintTop_toBottomOf="@+id/cross_profile_confirm"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/calendar_event_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/cross_profile_layout">
        <include layout="@layout/bedtime_card_guidelines"/>
        <TextView
            android:textSize="12sp"
            android:textColor="?android:attr/textColorSecondary"
            android:gravity="center"
            android:id="@+id/calendar_event_month"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_compat"
            app:layout_constraintEnd_toStartOf="@+id/start_guide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="20sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center"
            android:id="@+id/calendar_event_day"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_compat"
            app:layout_constraintEnd_toEndOf="@+id/start_guide"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/calendar_event_month"/>
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/calendar_event_empty"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="56dp"
            app:cardBackgroundColor="?attr/colorSurfaceVariant"
            app:cardCornerRadius="12dp"
            app:cardElevation="0dp"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:layout_gravity="center_vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/calendar_no_event"
                android:textDirection="locale"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"/>
        </com.google.android.material.card.MaterialCardView>
        <include
            android:id="@+id/calendar_event_0"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toTopOf="parent"
            layout="@layout/calendar_event_view"/>
        <include
            android:id="@+id/calendar_event_1"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
            app:layout_constraintStart_toEndOf="@+id/start_guide"
            app:layout_constraintTop_toBottomOf="@+id/calendar_event_0"
            layout="@layout/calendar_event_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <Button
        android:id="@+id/view_more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bedtime_button_margin_top"
        android:text="@string/open_calendar"
        app:layout_constraintEnd_toStartOf="@+id/end_guide_calendar"
        app:layout_constraintTop_toBottomOf="@+id/calendar_event_layout"/>
</androidx.constraintlayout.widget.ConstraintLayout>
