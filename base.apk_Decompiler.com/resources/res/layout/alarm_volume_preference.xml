<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:focusable="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="?attr/listPreferredItemHeightSmall"
    android:paddingStart="?android:attr/listPreferredItemPaddingStart"
    android:paddingEnd="?android:attr/listPreferredItemPaddingEnd">
    <LinearLayout
        android:gravity="start|center_vertical"
        android:orientation="horizontal"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="44dp"
        android:paddingEnd="12dp">
        <ImageView
            android:id="@+id/alarm_icon"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@null"
            android:importantForAccessibility="no"
            app:tint="?attr/colorControlNormal"
            app:tintMode="src_in"/>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="8dp">
        <TextView
            android:textAppearance="?android:attr/textAppearanceListItem"
            android:textColor="?android:attr/textColorPrimary"
            android:ellipsize="end"
            android:id="@android:id/title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:paddingStart="12dp"/>
        <com.google.android.material.slider.Slider
            android:layout_gravity="center_vertical"
            android:id="@+id/alarm_volume_slider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:maxHeight="@dimen/google_min_touch_target_size"
            android:contentDescription="@string/alarm_volume_title"
            style="@style/Widget.GoogleMaterial3.Slider"/>
    </LinearLayout>
</LinearLayout>
