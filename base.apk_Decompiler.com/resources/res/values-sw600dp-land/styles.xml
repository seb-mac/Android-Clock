<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="BedtimeFragmentRecyclerViewStyle" parent="">
        <item name="layoutManager">android.support.v7.widget.StaggeredGridLayoutManager</item>
        <item name="spanCount">2</item>
    </style>
    <style name="BedtimeOnboardingHeaderStyle" parent="">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">@id/fold_vertical_start_edge</item>
        <item name="layout_constraintStart_toStartOf">parent</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
        <item name="layout_constraintVertical_bias">0.4</item>
    </style>
    <style name="BedtimeOnboardingSettingStyle" parent="">
        <item name="android:layout_marginHorizontal">32dp</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/fold_vertical_end_edge</item>
    </style>
    <style name="BedtimeOnboardingTimeStyle" parent="">
        <item name="android:layout_marginHorizontal">32dp</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/fold_vertical_end_edge</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
    <style name="FabContainerStyle" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">-2</item>
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toEndOf">parent</item>
        <item name="layout_constraintStart_toStartOf">@id/fold_vertical_end_edge</item>
    </style>
    <style name="TimerSetupDigits" parent="">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toStartOf">@id/setup_digits_end</item>
        <item name="layout_constraintStart_toEndOf">@id/setup_digits_start</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
    <style name="TimerSetupTime" parent="@style/TimerSetupTimeBase">
        <item name="layout_constraintBottom_toBottomOf">parent</item>
        <item name="layout_constraintEnd_toStartOf">@id/setup_digits_start</item>
        <item name="layout_constraintStart_toStartOf">@id/timer_setup_view_start</item>
        <item name="layout_constraintTop_toTopOf">parent</item>
    </style>
</resources>
