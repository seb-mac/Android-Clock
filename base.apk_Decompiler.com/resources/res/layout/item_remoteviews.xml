<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_gravity="center"
    android:orientation="vertical"
    android:paddingTop="@dimen/remoteviews_item_margin_top_bottom"
    android:paddingBottom="@dimen/remoteviews_item_margin_top_bottom"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground"
    android:paddingStart="@dimen/remoteviews_item_margin_start_end"
    android:paddingEnd="@dimen/remoteviews_item_margin_start_end">
    <include layout="@layout/layout_remoteviews"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBody2"
        android:id="@+id/textview_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/remoteviews_text_margin_top"
        android:layout_marginBottom="@dimen/remoteviews_text_margin_bottom"/>
</LinearLayout>
