<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/saver_container"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/main_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/time_margin_top"
        android:layout_marginBottom="@dimen/screensaver_margin"
        android:layout_marginStart="@dimen/screensaver_margin"
        android:layout_marginEnd="@dimen/screensaver_margin">
        <com.android.deskclock.widget.AnalogClock
            android:theme="@style/Theme.DeskClock.AnalogWidget"
            android:layout_gravity="center_horizontal"
            android:id="@+id/analog_clock"
            android:layout_width="@dimen/analog_clock_size"
            android:layout_height="@dimen/analog_clock_size"
            android:layout_marginBottom="@dimen/bottom_text_spacing_analog"/>
        <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextClock
            android:textAppearance="@style/TextAppearance.TextClock"
            android:textSize="@dimen/main_clock_font_size"
            android:textColor="@android:color/white"
            android:ellipsize="none"
            android:gravity="center"
            android:layout_gravity="center"
            android:id="@+id/digital_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/bottom_text_spacing_digital"
            android:singleLine="true"/>
        <TextView
            android:textAppearance="@style/TextAppearance.GoogleMaterial3.BodyLarge"
            android:textSize="18sp"
            android:layout_gravity="center"
            android:id="@+id/date_and_next_alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxLines="1"/>
    </LinearLayout>
</FrameLayout>
