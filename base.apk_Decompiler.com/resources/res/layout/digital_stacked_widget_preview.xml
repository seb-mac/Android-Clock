<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.DeskClock.DigitalWidget"
    android:gravity="center"
    android:orientation="vertical"
    android:background="@drawable/digital_stadium_background"
    android:padding="@dimen/stacked_widget_preview_padding"
    android:layout_width="@dimen/stacked_widget_preview_widget_width"
    android:layout_height="@dimen/stacked_widget_preview_widget_height"
    android:backgroundTint="?android:attr/colorBackground"
    android:clipToOutline="true">
    <TextClock
        android:textAppearance="@style/TextAppearance.DigitalAppWidget.Label"
        android:textSize="@dimen/stacked_widget_preview_label_font_size"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/date"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:format12Hour="@string/abbrev_wday_month_day_no_year_preview"
        android:format24Hour="@string/abbrev_wday_month_day_no_year_preview"/>
    <TextClock
        android:textAppearance="@style/TextAppearance.DigitalAppWidget.TextClockPrimary"
        android:textSize="@dimen/stacked_widget_preview_clock_font_size"
        android:textColor="@color/appwidget_clock_hour_text_color"
        android:ellipsize="none"
        android:layout_gravity="center"
        android:id="@+id/clock_hours"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stacked_widget_preview_outer_clock_margin"
        android:layout_marginBottom="@dimen/stacked_widget_preview_inner_clock_margin"
        android:singleLine="true"
        android:format12Hour="@string/stacked_appwidget_hours_12_hour_format"
        android:format24Hour="@string/stacked_appwidget_hours_24_hour_format"/>
    <TextClock
        android:textAppearance="@style/TextAppearance.DigitalAppWidget.TextClockPrimary"
        android:textSize="@dimen/stacked_widget_preview_clock_font_size"
        android:textColor="?android:attr/colorAccent"
        android:ellipsize="none"
        android:layout_gravity="center"
        android:id="@+id/clock_minutes"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/stacked_widget_preview_inner_clock_margin"
        android:layout_marginBottom="@dimen/stacked_widget_preview_outer_clock_margin"
        android:singleLine="true"
        android:format12Hour="@string/stacked_appwidget_minutes_format"
        android:format24Hour="@string/stacked_appwidget_minutes_format"/>
    <LinearLayout
        android:layout_gravity="top|center_horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_gravity="center"
            android:id="@+id/alarm_icon"
            android:layout_width="@dimen/stacked_widget_preview_label_font_size"
            android:layout_height="@dimen/stacked_widget_preview_label_font_size"
            android:src="@drawable/ic_tab_alarm_white_24dp"
            android:scaleType="fitCenter"
            android:tint="@color/appwidget_label_color"
            android:importantForAccessibility="no"
            android:layout_marginEnd="@dimen/stacked_widget_preview_alarm_icon_margin"/>
        <TextView
            android:textAppearance="@style/TextAppearance.DigitalAppWidget.Label"
            android:textSize="@dimen/stacked_widget_preview_label_font_size"
            android:ellipsize="none"
            android:layout_gravity="center"
            android:id="@+id/alarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/digital_widgets_preview_alarm"
            android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
