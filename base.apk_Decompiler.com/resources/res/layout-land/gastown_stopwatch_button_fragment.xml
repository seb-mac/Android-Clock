<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/start_stop_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/GastownStopwatchButtonTextStyleBase"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:text="@string/gastown_stopwatch_reset_button_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/start_stop_button"
        style="@style/GastownStopwatchLapResetButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/lap_button"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="76dp"
        android:text="@string/gastown_stopwatch_lap_button_text"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/reset_button"
        style="@style/GastownStopwatchLapResetButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
