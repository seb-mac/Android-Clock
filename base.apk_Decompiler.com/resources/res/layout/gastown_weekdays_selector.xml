<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scroll_left_button"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:contentDescription="@string/scroll_left_content_description"
        android:backgroundTint="@color/scroll_background_tint"
        app:icon="@drawable/gs_arrow_left_vd_theme_24"
        app:iconTint="@color/scroll_icon_tint"
        app:layout_constraintBottom_toTopOf="@+id/day_buttons_scroll_view"
        app:layout_constraintEnd_toStartOf="@+id/scroll_right_button"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Xsmall"
        style="?attr/materialIconButtonFilledStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/scroll_right_button"
        android:padding="12dp"
        android:visibility="gone"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:contentDescription="@string/scroll_right_content_description"
        android:backgroundTint="@color/scroll_background_tint"
        app:icon="@drawable/gs_arrow_right_vd_theme_24"
        app:iconTint="@color/scroll_icon_tint"
        app:layout_constraintBottom_toTopOf="@+id/day_buttons_scroll_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/scroll_left_button"
        app:layout_constraintTop_toTopOf="parent"
        app:materialSizeOverlay="@style/SizeOverlay.Material3Expressive.Button.IconButton.Xsmall"
        style="?attr/materialIconButtonFilledStyle"/>
    <HorizontalScrollView
        android:id="@+id/day_buttons_scroll_view"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/scroll_left_button">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <CheckBox
                android:id="@+id/day_button_0"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_1"
                app:layout_constraintHorizontal_chainStyle="spread_inside"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_1"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_2"
                app:layout_constraintStart_toEndOf="@+id/day_button_0"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_2"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_3"
                app:layout_constraintStart_toEndOf="@+id/day_button_1"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_3"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_4"
                app:layout_constraintStart_toEndOf="@+id/day_button_2"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_4"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_5"
                app:layout_constraintStart_toEndOf="@+id/day_button_3"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_5"
                android:layout_marginEnd="4dp"
                app:layout_constraintEnd_toStartOf="@+id/day_button_6"
                app:layout_constraintStart_toEndOf="@+id/day_button_4"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
            <CheckBox
                android:id="@+id/day_button_6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/day_button_5"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/GastownWeekdayButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </HorizontalScrollView>
</merge>
