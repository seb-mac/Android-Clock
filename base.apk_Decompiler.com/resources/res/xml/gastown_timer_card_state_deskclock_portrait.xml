<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/gastown_timer_card_state_deskclock_portrait">
    <Constraint android:id="@+id/timer_track">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/gastown_track_end"
            app:layout_constraintStart_toEndOf="@+id/gastown_track_start"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"
            app:layout_constraintVertical_bias="0.3"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track_expired">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="@dimen/timer_label_area_margin_portrait"
            app:layout_constraintEnd_toStartOf="@+id/delete_button"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x800013"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="@dimen/timer_track_thickness"
            android:layout_marginEnd="@dimen/timer_track_thickness"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
    </Constraint>
    <Constraint android:id="@+id/reset_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toTopOf="@+id/gastown_bottom_gutter"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toStartOf="@+id/delete_button_spacer"
            app:layout_constraintHeight_percent="0.17"
            app:layout_constraintHorizontal_weight="0"
            app:layout_constraintStart_toEndOf="@+id/portrait_spacer_between_add_one_min_and_reset_button"
            app:layout_constraintTop_toBottomOf="@+id/timer_track"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/add_one_min_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="20dp"
            app:layout_constraintBottom_toTopOf="@+id/gastown_bottom_gutter"
            app:layout_constraintDimensionRatio="H,1:2"
            app:layout_constraintEnd_toStartOf="@+id/portrait_spacer_between_add_one_min_and_reset_button"
            app:layout_constraintHeight_percent="0.17"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintHorizontal_weight="0"
            app:layout_constraintStart_toEndOf="@+id/timer_track_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_track"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="-12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toBottomOf="@+id/timer_text"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/delete_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="@dimen/timer_label_area_margin_portrait"
            android:layout_marginEnd="@dimen/timer_label_area_margin_portrait"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/delete_button_spacer"
            app:layout_constraintTop_toBottomOf="@+id/delete_button_spacer"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
</ConstraintSet>
