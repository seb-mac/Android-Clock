<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/alarm_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    style="@style/GastownAlarmMaterialCardViewStyle">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/alarm_card_layout"
        android:padding="20dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/alarm_header"
            android:background="@android:color/transparent"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:importantForAccessibility="noHideDescendants"
            app:alignItems="center"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toStartOf="@+id/watch_alarm_icon_tappable_area"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">
            <TextView
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:gravity="start|center_vertical"
                android:id="@+id/pause_resume_text"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:drawablePadding="@dimen/alarm_card_drawable_padding"
                android:layout_marginEnd="8dp"
                android:drawableTint="?attr/colorOnPrimaryContainer"/>
            <ImageView
                android:id="@+id/workflow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:contentDescription="@string/alarm_routines"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="@dimen/icon_margin"/>
            <TextView
                android:gravity="center_vertical"
                android:id="@+id/workflow_separator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/bullet"
                android:importantForAccessibility="no"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="@dimen/icon_margin"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:gravity="center_vertical"
                android:id="@+id/days_of_week"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="@dimen/icon_margin"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:gravity="center_vertical"
                android:id="@+id/upcoming_instance_label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawablePadding="@dimen/alarm_card_drawable_padding"
                android:layout_marginEnd="8dp"
                android:paddingHorizontal="@dimen/icon_margin"/>
            <TextView
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="3"
                android:alpha="0.84"
                android:layout_marginEnd="8dp"/>
            <Space
                android:layout_width="0dp"
                android:layout_height="@dimen/google_min_touch_target_size"
                app:layout_flexGrow="1"/>
            <Button
                android:textAppearance="@style/PredismissButtonTextStyle"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:gravity="start|center_vertical"
                android:id="@+id/preemptive_dismiss"
                android:paddingTop="0dp"
                android:paddingBottom="0dp"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                style="?attr/borderlessButtonStyle"/>
        </com.google.android.flexbox.FlexboxLayout>
        <FrameLayout
            android:id="@+id/watch_alarm_icon_tappable_area"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toBottomOf="@+id/alarm_header"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintTop_toTopOf="@+id/alarm_header"
            app:layout_constraintVertical_bias="0"
            app:layout_goneMarginEnd="0dp">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/watch_alarm_icon"
                android:focusable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/gs_watch_fill1_vd_theme_24"
                android:contentDescription="@string/watch_icon_content_desc"/>
        </FrameLayout>
        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/header_row_barrier"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="alarm_header,watch_alarm_icon_tappable_area"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/clock_switch_flow"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:constraint_referenced_ids="digital_clock,onoff"
            app:flow_horizontalStyle="spread_inside"
            app:flow_verticalGap="8dp"
            app:flow_wrapMode="chain"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/header_row_barrier"/>
        <include
            android:id="@+id/digital_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            layout="@layout/gastown_alarm_time_summary"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/onoff"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"/>
        <ImageView
            android:id="@+id/silent_vibrate_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/silent_vibrate_text"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/silent_vibrate_text"/>
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:id="@+id/silent_vibrate_text"
            android:focusable="true"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/silent_vibrate_icon"
            app:layout_constraintTop_toBottomOf="@+id/clock_switch_flow"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <View
        android:id="@+id/scrim_overlay_view"
        android:background="#99000000"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</com.google.android.material.card.MaterialCardView>
