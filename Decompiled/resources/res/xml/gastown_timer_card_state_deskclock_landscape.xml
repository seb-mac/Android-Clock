<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/gastown_timer_card_state_deskclock_landscape">
    <Constraint android:id="@+id/timer_track_spacer">
        <Layout
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_track"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/timer_track_spacer_vert"
            app:layout_constraintVertical_bias="1"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="32dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/land_track_end"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"
            app:layout_constraintVertical_bias="0"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track_expired">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="@dimen/timer_label_area_margin_landscape"
            android:layout_marginEnd="@dimen/timer_label_margin_end"
            app:layout_constraintEnd_toStartOf="@+id/delete_button"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x800013"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_start">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toStartOf="@+id/timer_text"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toStartOf="@+id/timer_text_spacer_end"
            app:layout_constraintHorizontal_weight="76"
            app:layout_constraintStart_toEndOf="@+id/timer_text_spacer_start"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_end">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toEndOf="@+id/timer_text"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/reset_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintTop_toBottomOf="@+id/add_one_min_button"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/add_one_min_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginEnd="20dp"
            app:layout_constraintBottom_toTopOf="@+id/reset_button"
            app:layout_constraintDimensionRatio="H,1:2.0"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_percent="0.2"
            app:layout_constraintTop_toTopOf="@+id/timer_track"
            app:layout_constraintVertical_chainStyle="packed"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toBottomOf="@+id/timer_text"
            app:layout_constraintVertical_bias="0.2"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/delete_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="@dimen/timer_label_area_margin_landscape"
            android:layout_marginEnd="@dimen/timer_label_area_margin_landscape"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/delete_button_spacer"
            app:layout_constraintTop_toBottomOf="@+id/delete_button_spacer"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
</ConstraintSet>
