<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timer_setup_scroller"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="2dp">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_controls_start"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.02"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/left_controls_end"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.46"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/right_controls_start"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.48"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/right_controls_end"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            app:layout_constraintGuide_percent="0.98"/>
        <android.support.v4.app.FragmentContainerView
            android:id="@+id/duration_picker_fragment_container"
            android:layout_width="338dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/left_controls_end"
            app:layout_constraintStart_toStartOf="@+id/left_controls_start"
            app:layout_constraintTop_toTopOf="parent"/>
        <include
            android:id="@+id/timer_label_setting"
            android:layout_width="322dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            app:layout_constraintEnd_toStartOf="@+id/left_controls_end"
            app:layout_constraintStart_toStartOf="@+id/left_controls_start"
            app:layout_constraintTop_toBottomOf="@+id/duration_picker_fragment_container"
            layout="@layout/timer_label_view"/>
        <com.google.android.material.button.MaterialButton
            android:textSize="25sp"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:gravity="center"
            android:id="@+id/time_start_button"
            android:layout_width="326dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/timer_start_button_text"
            android:maxLines="20"
            android:backgroundTint="?attr/colorTertiaryContainer"
            app:layout_constraintEnd_toEndOf="@+id/right_controls_end"
            app:layout_constraintHeight_max="76dp"
            app:layout_constraintHeight_min="76dp"
            app:layout_constraintStart_toEndOf="@+id/right_controls_start"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/Widget.GoogleMaterial3Expressive.Button"/>
        <include
            android:id="@+id/timer_preset_container"
            android:layout_width="326dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="@+id/right_controls_end"
            app:layout_constraintStart_toEndOf="@+id/right_controls_start"
            app:layout_constraintTop_toBottomOf="@+id/time_start_button"
            layout="@layout/timer_preset_group"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
