<?xml version="1.0" encoding="utf-8"?>
<com.android.deskclock.timer.TimerCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="0dp"
    android:layout_height="0dp"
    android:importantForAccessibility="no"
    app:layoutDescription="@xml/timer_card_scene">
    <View
        android:id="@+id/timer_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/timer_track"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:indeterminate="false"
        android:importantForAccessibility="no"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="@dimen/timer_legacy_track_progress_indicator_size"
        app:indicatorTrackGapSize="@dimen/timer_legacy_track_progress_indicator_gap_size"
        app:trackColor="?attr/colorOutlineVariant"
        app:trackCornerRadius="@dimen/timer_legacy_track_corner_radius"
        app:trackThickness="@dimen/timer_legacy_track_thickness"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/timer_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:textAppearance="@style/TimerCountdownTextPausedStyle"
        android:textSize="80sp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/timer_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/track_button_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/track_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:guidelineUseRtl="true"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/track_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:guidelineUseRtl="true"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/bottom_gutter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.9"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/play_pause_start_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.38"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/play_pause_end_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.62"/>
    <Space
        android:id="@+id/tertiary_button_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/tertiary_button_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/tertiary_button_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/tertiary_button_spacer_vert"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/tertiary_button_spacer_horiz"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <Space
        android:id="@+id/timer_label_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/timer_label_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/timer_label_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/timer_label_spacer_vert"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/timer_label_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <Space
        android:id="@+id/timer_track_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/timer_track_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/timer_track_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/timer_track_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timer_track_spacer_vert"
        app:layout_constraintVertical_bias="1"/>
    <Space
        android:id="@+id/timer_text_spacer_start"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <Space
        android:id="@+id/timer_text_spacer_end"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_pause"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:borderWidth="0dp"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnTertiary"
        app:layout_constraintBottom_toTopOf="@+id/bottom_gutter"
        app:layout_constraintDimensionRatio="H,3:2"
        app:layout_constraintEnd_toStartOf="@+id/play_pause_end_guide"
        app:layout_constraintStart_toEndOf="@+id/play_pause_start_guide"
        app:layout_constraintTop_toBottomOf="@+id/timer_text"
        app:layout_constraintVertical_bias="1"
        app:layout_constraintWidth_max="142dp"/>
    <Space
        android:id="@+id/primary_button_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_pause"
        app:layout_constraintHeight_percent="0.075"
        app:layout_constraintStart_toEndOf="@+id/play_pause"/>
    <Space
        android:id="@+id/primary_button_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_pause"
        app:layout_constraintStart_toEndOf="@+id/play_pause"
        app:layout_constraintWidth_percent="0.075"/>
    <Space
        android:id="@+id/primary_button_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/play_pause"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/primary_button_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/play_pause"
        app:layout_constraintTop_toTopOf="@+id/primary_button_spacer_vert"
        app:layout_constraintVertical_bias="1"/>
    <com.google.android.material.button.MaterialButton
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/primary_button"
        android:padding="8dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeTextType="uniform"
        app:backgroundTint="?attr/colorSurfaceBright"
        app:borderWidth="0dp"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnSurface"
        style="@style/TimerPrimaryButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/secondary_button"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:insetLeft="6dp"
        android:insetRight="6dp"
        android:insetTop="4dp"
        android:insetBottom="8dp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/tertiary_button"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:layout_marginTop="-12dp"
        android:insetLeft="8dp"
        android:insetRight="8dp"
        android:insetTop="8dp"
        android:insetBottom="8dp"
        android:layout_marginEnd="-12dp"
        app:backgroundTint="?attr/colorSurfaceBright"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="20dp"
        app:iconTint="?attr/colorOnSurface"/>
</com.android.deskclock.timer.TimerCard>
