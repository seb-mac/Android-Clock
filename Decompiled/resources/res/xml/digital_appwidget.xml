<?xml version="1.0" encoding="utf-8"?>
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="@dimen/default_digital_widget_width"
    android:minHeight="@dimen/default_digital_widget_height"
    android:updatePeriodMillis="0"
    android:initialLayout="@layout/loading_widget"
    android:configure="com.android.deskclock.DigitalAppWidgetConfigActivity"
    android:previewImage="@drawable/appwidget_digital_clock_preview"
    android:resizeMode="vertical|horizontal"
    android:minResizeWidth="@dimen/digital_widget_min_width"
    android:minResizeHeight="@dimen/digital_widget_min_height"
    android:widgetCategory="keyguard|home_screen"
    android:widgetFeatures="reconfigurable"
    android:previewLayout="@layout/digital_widget_preview"
    android:targetCellWidth="2"
    android:targetCellHeight="2"/>
