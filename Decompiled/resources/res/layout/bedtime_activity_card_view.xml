<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_gravity="center"
    android:id="@+id/graph_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <include layout="@layout/bedtime_card_guidelines"/>
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/app_usage_chip"
        android:background="@drawable/app_usage_chip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/google_min_touch_target_size"
        app:layout_constraintEnd_toEndOf="@+id/end_guide"
        app:layout_constraintTop_toTopOf="parent">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/chip_total_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="6dp"
            android:fontFamily="@font/google_sans_medium_compat"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/chip_top_app_0"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/chip_top_app_1"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginEnd="8dp"/>
        <ImageView
            android:id="@+id/chip_top_app_2"
            android:visibility="gone"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginTop="7dp"
            android:layout_marginBottom="7dp"
            android:layout_marginEnd="8dp"/>
    </LinearLayout>
    <ImageView
        android:id="@+id/dotted_line"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:elevation="2dp"
        app:layout_constraintBottom_toTopOf="@+id/wakeup_line"
        app:layout_constraintEnd_toEndOf="@+id/day_graph_6"
        app:layout_constraintStart_toStartOf="@+id/day_graph_6"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_chip"
        app:srcCompat="@drawable/dotted_line"/>
    <ImageView
        android:id="@+id/bedtime_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintBottom_toBottomOf="@+id/bedtime_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/bedtime_line"
        app:srcCompat="@drawable/quantum_gm_ic_local_hotel_vd_theme_24"
        app:tint="?android:attr/textColorSecondary"
        app:tintMode="src_in"/>
    <ImageView
        android:id="@+id/wakeup_icon"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:importantForAccessibility="no"
        android:layout_marginStart="19dp"
        android:layout_marginEnd="19dp"
        app:layout_constraintBottom_toBottomOf="@+id/wakeup_line"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/wakeup_line"
        app:srcCompat="@drawable/quantum_gm_ic_alarm_vd_theme_24"
        app:tint="?android:attr/textColorSecondary"
        app:tintMode="src_in"/>
    <View
        android:id="@+id/bedtime_line"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline_size"
        android:layout_marginTop="12dp"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/end_guide"
        app:layout_constraintStart_toEndOf="@+id/start_guide"
        app:layout_constraintTop_toBottomOf="@+id/app_usage_chip"/>
    <View
        android:id="@+id/wakeup_line"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="0dp"
        android:layout_height="@dimen/hairline_size"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/end_guide"
        app:layout_constraintStart_toEndOf="@+id/start_guide"
        app:layout_constraintTop_toBottomOf="@+id/day_graph_0"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_1"
        app:layout_constraintStart_toEndOf="@+id/start_guide"
        app:layout_constraintTop_toBottomOf="@+id/bedtime_line"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_1"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_2"
        app:layout_constraintStart_toEndOf="@+id/day_graph_0"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_2"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_3"
        app:layout_constraintStart_toEndOf="@+id/day_graph_1"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_3"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_4"
        app:layout_constraintStart_toEndOf="@+id/day_graph_2"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_4"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_5"
        app:layout_constraintStart_toEndOf="@+id/day_graph_3"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_5"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_6"
        app:layout_constraintStart_toEndOf="@+id/day_graph_4"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <com.android.deskclock.bedtime.ActivityVisualizerView
        android:id="@+id/day_graph_6"
        android:contentDescription="@string/alarm_today"
        app:layout_constraintBottom_toBottomOf="@+id/day_graph_0"
        app:layout_constraintEnd_toStartOf="@+id/end_guide"
        app:layout_constraintStart_toEndOf="@+id/day_graph_5"
        app:layout_constraintTop_toTopOf="@+id/day_graph_0"
        style="@style/ActivityVisualizerViewStyle"/>
    <View
        android:id="@+id/day_tick_0"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintStart_toStartOf="@+id/wakeup_line"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_1"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_1"
        app:layout_constraintStart_toEndOf="@+id/day_graph_0"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_2"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_2"
        app:layout_constraintStart_toEndOf="@+id/day_graph_1"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_3"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_3"
        app:layout_constraintStart_toEndOf="@+id/day_graph_2"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_4"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_4"
        app:layout_constraintStart_toEndOf="@+id/day_graph_3"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_5"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_5"
        app:layout_constraintStart_toEndOf="@+id/day_graph_4"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_6"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toStartOf="@+id/day_graph_6"
        app:layout_constraintStart_toEndOf="@+id/day_graph_5"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <View
        android:id="@+id/day_tick_7"
        android:background="?attr/colorSurfaceVariant"
        android:layout_width="@dimen/hairline_size"
        android:layout_height="@dimen/bedtime_graph_tick_height"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/wakeup_line"
        app:layout_constraintTop_toBottomOf="@+id/wakeup_line"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_0"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_0"
        app:layout_constraintStart_toStartOf="@+id/day_tick_0"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_0"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_1"
        app:layout_constraintStart_toStartOf="@+id/day_tick_1"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_1"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_2"
        app:layout_constraintStart_toStartOf="@+id/day_tick_2"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_2"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_3"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_3"
        app:layout_constraintStart_toStartOf="@+id/day_tick_3"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_3"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_4"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_4"
        app:layout_constraintStart_toStartOf="@+id/day_tick_4"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_4"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_5"
        app:layout_constraintStart_toStartOf="@+id/day_tick_5"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_5"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_6"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_6"
        app:layout_constraintStart_toStartOf="@+id/day_tick_6"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_6"/>
    <TextView
        android:textSize="@dimen/graph_day_label_text_size"
        android:textColor="?android:attr/textColorSecondary"
        android:layout_gravity="center_vertical"
        android:id="@+id/day_label_7"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:importantForAccessibility="no"
        app:layout_constraintEnd_toEndOf="@+id/day_tick_7"
        app:layout_constraintStart_toStartOf="@+id/day_tick_7"
        app:layout_constraintTop_toBottomOf="@+id/day_tick_7"/>
    <androidx.constraintlayout.helper.widget.Flow
        android:id="@+id/label_flow"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:constraint_referenced_ids="screen_time_label,in_bed_label"
        app:flow_horizontalBias="0"
        app:flow_wrapMode="chain"
        app:layout_constraintBottom_toTopOf="@+id/bedtime_cough_snore_container"
        app:layout_constraintEnd_toEndOf="@+id/end_guide"
        app:layout_constraintStart_toEndOf="@+id/start_guide"
        app:layout_constraintTop_toBottomOf="@+id/day_label_7"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_gravity="center_vertical"
        android:id="@+id/screen_time_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/screen_time"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_circle_white"
        android:layout_marginStart="8dp"
        android:drawableTint="?attr/colorPrimary"
        android:paddingVertical="8dp"
        app:layout_constrainedWidth="true"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:layout_gravity="center_vertical"
        android:id="@+id/in_bed_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/in_bed"
        android:drawablePadding="8dp"
        android:drawableStart="@drawable/ic_circle_white"
        android:layout_marginStart="8dp"
        android:drawableTint="?attr/colorTertiary"
        android:paddingVertical="8dp"
        app:layout_constrainedWidth="true"/>
    <include
        android:id="@+id/bedtime_cough_snore_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/label_flow"
        layout="@layout/bedtime_cough_snore"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="center"
        android:id="@+id/app_usage_no_data"
        android:visibility="gone"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:text="@string/bedtime_activity_tomorrow"
        android:fontFamily="@font/google_sans_medium_compat"
        app:layout_constraintBottom_toTopOf="@+id/wakeup_line"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bedtime_line"/>
</androidx.constraintlayout.widget.ConstraintLayout>
