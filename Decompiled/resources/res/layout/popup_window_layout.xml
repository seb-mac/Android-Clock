<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/move_up_container"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/google_min_touch_target_size"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/move_up"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/popup_window_move_up_city"
            android:contentDescription="@string/popup_window_move_up_city_content_description"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toStartOf="@+id/icon_move_up"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon_move_up"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gs_arrow_upward_vd_theme_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/move_down_container"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:visibility="gone"
        android:clickable="true"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/google_min_touch_target_size"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurface"
            android:id="@+id/move_down"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/popup_window_move_down_city"
            android:contentDescription="@string/popup_window_move_down_city_content_description"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toStartOf="@+id/icon_move_down"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon_move_down"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gs_arrow_downward_vd_theme_20"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="?attr/colorOnSurface"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/remove_container"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="240dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/google_min_touch_target_size"
        android:paddingHorizontal="16dp"
        android:paddingVertical="6dp">
        <TextView
            android:textAppearance="?attr/textAppearanceBodyLarge"
            android:textSize="16sp"
            android:textColor="?attr/colorError"
            android:id="@+id/remove_city"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="@string/popup_window_remove_city"
            android:contentDescription="@string/popup_window_remove_city"
            android:paddingVertical="6dp"
            app:layout_constraintEnd_toStartOf="@+id/icon_remove_item"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/icon_remove_item"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/gs_do_not_disturb_on_fill1_vd_theme_20"
            android:tint="?attr/colorError"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
