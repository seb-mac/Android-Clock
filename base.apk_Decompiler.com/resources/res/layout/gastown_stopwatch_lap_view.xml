<?xml version="1.0" encoding="utf-8"?>
<com.android.deskclock.stopwatch.gastown.impl.ui.widget.SquareConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/lap_item_background"
    android:paddingTop="16dp"
    android:paddingBottom="16dp"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:minWidth="106dp"
    android:minHeight="106dp"
    android:layout_marginEnd="@dimen/gastown_stopwatch_lap_view_margin">
    <TextView
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/lap_number"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/lap_time"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread"
        style="@style/GastownStopwatchLapViewTextStyle"/>
    <TextView
        android:textColor="?attr/colorOnSurface"
        android:id="@+id/lap_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/lap_total"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lap_number"
        style="@style/GastownStopwatchLapViewTextStyle"/>
    <TextView
        android:textColor="?attr/colorOnSurfaceVariant"
        android:id="@+id/lap_total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lap_time"
        style="@style/GastownStopwatchLapViewTextStyle"/>
</com.android.deskclock.stopwatch.gastown.impl.ui.widget.SquareConstraintLayout>
