<?xml version="1.0" encoding="utf-8"?>
<MotionScene xmlns:android="http://schemas.android.com/apk/res/android" xmlns:motion="http://schemas.android.com/apk/res-auto">
    <ConstraintSet android:id="@+id/state_unknown">
        <ConstraintOverride
            android:id="@+id/sunrise_scroll_view"
            android:visibility="invisible"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/predismiss"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/title"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/subtitle"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/thumb"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/track"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/snooze_drag_target"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/dismiss_drag_target"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/track_left"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/track_right"
            motion:visibilityMode="ignore"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/state_sunrising">
        <ConstraintOverride
            android:id="@+id/sunrise_scroll_view"
            android:visibility="visible"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/predismiss"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/title"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/subtitle"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/thumb"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/track"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/snooze_drag_target"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/dismiss_drag_target"
            android:visibility="invisible"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/state_swipe_firing">
        <Constraint android:id="@+id/sunrise_scroll_view">
            <PropertySet
                android:visibility="invisible"
                motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/thumb">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/track_inset_thumb_margin"
                android:layout_marginTop="@dimen/track_inset_thumb_margin"
                android:layout_marginRight="@dimen/track_inset_thumb_margin"
                android:layout_marginBottom="@dimen/track_inset_thumb_margin"
                motion:layout_constraintBottom_toBottomOf="@+id/track"
                motion:layout_constraintDimensionRatio="3:2"
                motion:layout_constraintLeft_toLeftOf="@+id/horizontal_center"
                motion:layout_constraintRight_toRightOf="@+id/horizontal_center"
                motion:layout_constraintTop_toTopOf="@+id/track"/>
        </Constraint>
        <Constraint android:id="@+id/subtitle">
            <PropertySet android:visibility="invisible"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/predismiss"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/track_left"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/track_right"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/button_tap_dismiss"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/button_tap_snooze"
            android:visibility="invisible"/>
    </ConstraintSet>
    <ConstraintSet android:id="@+id/state_tap_firing">
        <Constraint android:id="@+id/sunrise_scroll_view">
            <PropertySet
                android:visibility="invisible"
                motion:visibilityMode="ignore"/>
        </Constraint>
        <Constraint android:id="@+id/subtitle">
            <PropertySet android:visibility="invisible"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            motion:visibilityMode="ignore"/>
        <ConstraintOverride
            android:id="@+id/button_tap_dismiss"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/button_tap_snooze"
            android:visibility="visible"/>
        <ConstraintOverride
            android:id="@+id/predismiss"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/thumb"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/track"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/snooze_drag_target"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/dismiss_drag_target"
            android:visibility="invisible"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/state_swipe_snooze"
        motion:deriveConstraintsFrom="@+id/state_swipe_firing">
        <Constraint android:id="@+id/thumb">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/track_inset_thumb_margin"
                android:layout_marginTop="@dimen/track_inset_thumb_margin"
                android:layout_marginRight="@dimen/track_inset_thumb_margin"
                android:layout_marginBottom="@dimen/track_inset_thumb_margin"
                motion:layout_constraintBottom_toBottomOf="@+id/track"
                motion:layout_constraintDimensionRatio="3:2"
                motion:layout_constraintLeft_toLeftOf="@+id/track"
                motion:layout_constraintTop_toTopOf="@+id/track"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/snooze_drag_target"
            android:visibility="invisible"
            android:clickable="false"/>
        <ConstraintOverride
            android:id="@+id/dismiss_drag_target"
            android:visibility="invisible"
            android:clickable="false"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/state_snooze"
        motion:deriveConstraintsFrom="@+id/state_swipe_snooze">
        <Constraint android:id="@+id/sunrise_scroll_view">
            <PropertySet
                android:visibility="invisible"
                motion:visibilityMode="normal"/>
        </Constraint>
        <Constraint android:id="@+id/thumb">
            <PropertySet android:visibility="invisible"/>
        </Constraint>
        <Constraint android:id="@+id/subtitle">
            <PropertySet android:visibility="visible"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/track"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            android:visibility="invisible"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/state_swipe_dismiss"
        motion:deriveConstraintsFrom="@+id/state_swipe_firing">
        <Constraint android:id="@+id/thumb">
            <Layout
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginLeft="@dimen/track_inset_thumb_margin"
                android:layout_marginTop="@dimen/track_inset_thumb_margin"
                android:layout_marginRight="@dimen/track_inset_thumb_margin"
                android:layout_marginBottom="@dimen/track_inset_thumb_margin"
                motion:layout_constraintBottom_toBottomOf="@+id/track"
                motion:layout_constraintDimensionRatio="3:2"
                motion:layout_constraintRight_toRightOf="@+id/track"
                motion:layout_constraintTop_toTopOf="@+id/track"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/snooze_drag_target"
            android:visibility="invisible"
            android:clickable="false"/>
        <ConstraintOverride
            android:id="@+id/dismiss_drag_target"
            android:visibility="invisible"
            android:clickable="false"/>
    </ConstraintSet>
    <ConstraintSet
        android:id="@+id/state_dismiss"
        motion:deriveConstraintsFrom="@+id/state_swipe_dismiss">
        <Constraint android:id="@+id/sunrise_scroll_view">
            <PropertySet
                android:visibility="invisible"
                motion:visibilityMode="normal"/>
        </Constraint>
        <Constraint android:id="@+id/thumb">
            <PropertySet android:visibility="invisible"/>
        </Constraint>
        <ConstraintOverride
            android:id="@+id/track"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/digital_clock"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_attribution_logo"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_primary_attribution_text"
            android:visibility="invisible"/>
        <ConstraintOverride
            android:id="@+id/music_secondary_attribution_text"
            android:visibility="invisible"/>
    </ConstraintSet>
    <Transition
        motion:constraintSetEnd="@+id/state_sunrising"
        motion:constraintSetStart="@+id/state_unknown"
        motion:duration="100"
        motion:layoutDuringTransition="honorRequest"/>
    <Transition
        motion:constraintSetEnd="@+id/state_swipe_firing"
        motion:constraintSetStart="@+id/state_unknown"
        motion:duration="100"
        motion:layoutDuringTransition="honorRequest"/>
    <Transition
        android:id="@+id/transition_swipe_snooze"
        motion:constraintSetEnd="@+id/state_swipe_snooze"
        motion:constraintSetStart="@+id/state_swipe_firing"
        motion:duration="200"
        motion:motionInterpolator="linear">
        <OnSwipe
            motion:dragDirection="dragLeft"
            motion:dragThreshold="0"
            motion:maxAcceleration="50"
            motion:maxVelocity="150"
            motion:onTouchUp="stop"
            motion:touchAnchorId="@+id/thumb"
            motion:touchRegionId="@+id/thumb"/>
    </Transition>
    <Transition
        android:id="@+id/transition_swipe_dismiss"
        motion:constraintSetEnd="@+id/state_swipe_dismiss"
        motion:constraintSetStart="@+id/state_swipe_firing"
        motion:duration="200"
        motion:motionInterpolator="linear">
        <OnSwipe
            motion:dragDirection="dragRight"
            motion:dragThreshold="0"
            motion:maxAcceleration="50"
            motion:maxVelocity="150"
            motion:onTouchUp="stop"
            motion:touchAnchorId="@+id/thumb"
            motion:touchRegionId="@+id/thumb"/>
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/state_dismiss"
        motion:constraintSetStart="@+id/state_swipe_dismiss"
        motion:duration="750">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/sunrise_scroll_view"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/digital_clock"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_primary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_secondary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_attribution_logo"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/title"/>
            <KeyTrigger
                motion:framePosition="50"
                motion:motionTarget="@+id/title"
                motion:triggerId="@+id/trigger_update_title_and_subtitle"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/title"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/thumb"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/track"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/state_snooze"
        motion:constraintSetStart="@+id/state_swipe_snooze"
        motion:duration="750">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/sunrise_scroll_view"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/digital_clock"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_primary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_secondary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_attribution_logo"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/title"/>
            <KeyTrigger
                motion:framePosition="50"
                motion:motionTarget="@+id/title"
                motion:triggerId="@+id/trigger_update_title_and_subtitle"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/title"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/subtitle"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/thumb"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/track"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/state_tap_firing"
        motion:constraintSetStart="@+id/state_unknown"
        motion:duration="100"
        motion:layoutDuringTransition="honorRequest"/>
    <Transition
        motion:constraintSetEnd="@+id/state_dismiss"
        motion:constraintSetStart="@+id/state_tap_firing"
        motion:duration="750">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/sunrise_scroll_view"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/digital_clock"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_primary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_secondary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_attribution_logo"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/title"/>
            <KeyTrigger
                motion:framePosition="50"
                motion:motionTarget="@+id/title"
                motion:triggerId="@+id/trigger_update_title_and_subtitle"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/title"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/button_tap_snooze"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/button_tap_dismiss"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/state_snooze"
        motion:constraintSetStart="@+id/state_tap_firing"
        motion:duration="750">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/sunrise_scroll_view"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/digital_clock"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_primary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_secondary_attribution_text"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/music_attribution_logo"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/title"/>
            <KeyTrigger
                motion:framePosition="50"
                motion:motionTarget="@+id/title"
                motion:triggerId="@+id/trigger_update_title_and_subtitle"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/title"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/subtitle"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/button_tap_snooze"/>
            <KeyAttribute
                android:alpha="1"
                motion:framePosition="55"
                motion:motionTarget="@+id/button_tap_dismiss"/>
        </KeyFrameSet>
    </Transition>
    <Transition
        motion:constraintSetEnd="@+id/state_dismiss"
        motion:constraintSetStart="@+id/state_sunrising"
        motion:duration="750">
        <KeyFrameSet>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/sunrise_scroll_view"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/digital_clock"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/title"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="45"
                motion:motionTarget="@+id/predismiss"/>
            <KeyTrigger
                motion:framePosition="50"
                motion:motionTarget="@+id/title"
                motion:triggerId="@+id/trigger_update_title_and_subtitle"/>
            <KeyAttribute
                android:alpha="0"
                motion:framePosition="55"
                motion:motionTarget="@+id/title"/>
        </KeyFrameSet>
    </Transition>
</MotionScene>
