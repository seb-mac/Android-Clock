<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
            android:textSize="@dimen/stopwatch_time_text_size"
            android:gravity="center"
            android:id="@+id/stopwatch_time_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="64dp"
            android:minHeight="144dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            style="@style/GastownStopwatchTimeTextStyle"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/stopwatch_center_container_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.16"/>
        <FrameLayout
            android:orientation="horizontal"
            android:id="@+id/stopwatch_center_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="45dp"
            android:minHeight="106dp"
            app:layout_constraintEnd_toEndOf="@+id/stopwatch_center_container_end"
            app:layout_constraintStart_toStartOf="@+id/stopwatch_center_container_start"
            app:layout_constraintTop_toBottomOf="@+id/stopwatch_time_text"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/stopwatch_center_container_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.84"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/stopwatch_button_container_start"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.04"/>
        <FrameLayout
            android:id="@+id/stopwatch_button_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="87dp"
            android:layout_marginBottom="27dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/stopwatch_button_container_end"
            app:layout_constraintStart_toStartOf="@+id/stopwatch_button_container_start"
            app:layout_constraintTop_toBottomOf="@+id/stopwatch_center_container"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/stopwatch_button_container_end"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintGuide_percent="0.96"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
