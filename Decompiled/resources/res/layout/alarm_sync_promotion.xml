<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:scrollbars="vertical"
    android:layout_width="match_parent"
    android:layout_height="0dp"
    android:importantForAccessibility="no">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_start_percent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_end_percent"/>
        <TextView
            android:textSize="24sp"
            android:textColor="?attr/colorOnBackground"
            android:gravity="center"
            android:id="@+id/alarm_sync_promotion_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/sync_phone_and_wear_alarms_title"
            app:layout_constraintBottom_toTopOf="@+id/alarm_sync_promotion_description"
            app:layout_constraintEnd_toEndOf="@+id/end_guide"
            app:layout_constraintStart_toStartOf="@+id/start_guide"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="spread"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:gravity="center"
            android:id="@+id/alarm_sync_promotion_description"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:fontFamily="@font/google_sans_medium_compat"
            app:layout_constraintBottom_toTopOf="@+id/alarm_sync_promotion_graphic"
            app:layout_constraintEnd_toEndOf="@+id/end_guide"
            app:layout_constraintStart_toStartOf="@+id/start_guide"
            app:layout_constraintTop_toBottomOf="@+id/alarm_sync_promotion_title"/>
        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/alarm_sync_promotion_graphic"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="4dp"
            android:src="@drawable/alarm_sync_promotion_graphic"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toTopOf="@+id/alarm_sync_promotion_action_buttons"
            app:layout_constraintDimensionRatio="@string/explanation_graphic_ratio"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="@dimen/explanation_graphic_height_max"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/alarm_sync_promotion_description"
            app:layout_constraintWidth_max="@dimen/explanation_graphic_width_max"
            app:lottie_autoPlay="true"
            app:lottie_loop="true"
            app:lottie_rawRes="@raw/alarm_sync_promotion"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/alarm_sync_promotion_action_buttons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_button_area_top"
            android:layout_marginBottom="@dimen/onboarding_button_area_bottom"
            android:layout_marginStart="@dimen/onboarding_button_area_start"
            android:layout_marginEnd="@dimen/onboarding_button_area_end"
            app:constraint_referenced_ids="alarm_sync_promotion_skip,alarm_sync_promotion_next"
            app:flow_horizontalStyle="spread_inside"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button
            android:id="@+id/alarm_sync_promotion_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/onboarding_button_width"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/consent_no_thanks"
            android:textAllCaps="false"
            style="?attr/materialButtonOutlinedStyle"/>
        <Button
            android:id="@+id/alarm_sync_promotion_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/onboarding_button_width"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/action_sync_alarms"
            android:textAllCaps="false"
            style="@style/Widget.GoogleMaterial3.Button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
