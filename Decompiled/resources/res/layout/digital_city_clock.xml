<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:orientation="vertical"
    android:id="@+id/city_clock"
    android:background="@drawable/digital_cities_tile_background"
    android:layout_width="@dimen/cities_widget_tile_width_small"
    android:layout_height="@dimen/cities_widget_tile_height_small"
    android:backgroundTint="?attr/appWidgetBackgroundTint"
    android:clipToOutline="true">
    <TextView
        android:textAppearance="?attr/appWidgetTextAppearanceLabel"
        android:ellipsize="end"
        android:gravity="top|center_horizontal"
        android:id="@+id/city_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"/>
    <TextClock
        android:textAppearance="?attr/appWidgetTextAppearancePrimary"
        android:ellipsize="none"
        android:layout_gravity="center"
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:format12Hour="@string/cities_appwidget_12_hour_format"
        android:format24Hour="@string/cities_appwidget_24_hour_format"/>
    <TextClock
        android:textAppearance="?attr/appWidgetTextAppearancePrimary"
        android:ellipsize="none"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/am_pm_weekday"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:format12Hour="@string/am_pm_weekday_12hour"
        android:format24Hour="@string/am_pm_weekday_24hour"/>
    <LinearLayout
        android:gravity="center"
        android:orientation="horizontal"
        android:id="@+id/weather_section"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <android.widget.ImageView
            android:id="@+id/weather_image"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:tint="@color/appwidget_label_color"/>
        <TextView
            android:textAppearance="?attr/appWidgetTextAppearanceLabel"
            android:ellipsize="none"
            android:id="@+id/weather_temp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
        <FrameLayout
            android:id="@+id/weather_spacer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:importantForAccessibility="no"/>
        <TextView
            android:textAppearance="?attr/appWidgetTextAppearanceLabel"
            android:ellipsize="none"
            android:id="@+id/weather_high_low"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"/>
    </LinearLayout>
</LinearLayout>
