<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <capability android:name="actions.intent.START_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="CreateTimer">
            <parameter
                android:name="timer.duration"
                android:key="timer.duration"/>
            <parameter
                android:name="timer.identifier"
                android:key="timer.identifier"/>
            <parameter
                android:name="timer.name"
                android:key="timer.name"/>
        </service>
    </capability>
    <capability android:name="actions.intent.UPDATE_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="IncrementRemainingDuration">
            <parameter
                android:name="targetTimer"
                android:key="targetTimer"
                android:required="true"/>
            <parameter
                android:name="operation.fieldPath"
                android:key="operation.fieldPath"/>
            <parameter
                android:name="operation.change"
                android:key="operation.change"/>
            <parameter
                android:name="operation.@type"
                android:key="operation.@type"/>
        </service>
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="OverwriteRemainingDuration">
            <parameter
                android:name="targetTimer"
                android:key="targetTimer"
                android:required="true"/>
            <parameter
                android:name="operation.fieldPath"
                android:key="operation.fieldPath"/>
            <parameter
                android:name="operation.newValue"
                android:key="operation.newValue"/>
            <parameter
                android:name="operation.@type"
                android:key="operation.@type"/>
        </service>
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="OverwriteName">
            <parameter
                android:name="targetTimer"
                android:key="targetTimer"/>
            <parameter
                android:name="operation.fieldPath"
                android:key="operation.fieldPath"/>
            <parameter
                android:name="operation.newValue"
                android:key="operation.newValue"/>
            <parameter
                android:name="operation.@type"
                android:key="operation.@type"/>
        </service>
    </capability>
    <capability android:name="actions.intent.RESET_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="ResetTimer">
            <parameter
                android:name="timer"
                android:key="timer"/>
        </service>
    </capability>
    <capability android:name="actions.intent.STOP_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="DeleteTimer">
            <parameter
                android:name="timer"
                android:key="timer"/>
        </service>
    </capability>
    <capability android:name="actions.intent.PAUSE_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="PauseTimer">
            <parameter
                android:name="timer"
                android:key="timer"/>
        </service>
    </capability>
    <capability android:name="actions.intent.RESUME_TIMER">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="ResumeTimer">
            <parameter
                android:name="timer"
                android:key="timer"/>
        </service>
    </capability>
    <capability android:name="actions.intent.CREATE_ALARM">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="CreateAlarm">
            <parameter
                android:name="alarm.alarmSchedule"
                android:key="alarm.alarmSchedule"/>
            <parameter
                android:name="alarm.identifier"
                android:key="alarm.identifier"/>
            <parameter
                android:name="alarm.name"
                android:key="alarm.name"/>
        </service>
    </capability>
    <capability android:name="actions.intent.UPDATE_ALARM">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="OverwriteAlarmSchedule">
            <parameter
                android:name="targetAlarm"
                android:key="targetAlarm"
                android:required="true"/>
            <parameter
                android:name="operation.fieldPath"
                android:key="operation.fieldPath"/>
            <parameter
                android:name="operation.newValue"
                android:key="operation.newValue"/>
            <parameter
                android:name="operation.@type"
                android:key="operation.@type"/>
        </service>
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="OverwriteName">
            <parameter
                android:name="targetAlarm"
                android:key="targetAlarm"/>
            <parameter
                android:name="operation.fieldPath"
                android:key="operation.fieldPath"/>
            <parameter
                android:name="operation.newValue"
                android:key="operation.newValue"/>
            <parameter
                android:name="operation.@type"
                android:key="operation.@type"/>
        </service>
    </capability>
    <capability android:name="actions.intent.SNOOZE_ALARM">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="SnoozeAlarm">
            <parameter
                android:name="alarm"
                android:key="alarm"/>
            <parameter
                android:name="snoozeDuration"
                android:key="snoozeDuration"/>
        </service>
    </capability>
    <capability android:name="actions.intent.DISMISS_ALARM">
        <service
            android:name="com.android.deskclock.remoteactions.ActionsService"
            android:identifier="DismissAlarm">
            <parameter
                android:name="alarm"
                android:key="alarm"/>
        </service>
    </capability>
</shortcuts>
