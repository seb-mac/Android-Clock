<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:paddingTop="12dp"
    android:paddingBottom="12dp"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:foreground="?attr/selectableItemBackground">
    <include layout="@layout/centered_guidelines"/>
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/ringtone_image_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:importantForAccessibility="no"
        app:cardBackgroundColor="@android:color/transparent"
        app:cardCornerRadius="4dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toEndOf="@+id/start_guide"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/ringtone_image"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:scaleType="centerInside"
            android:importantForAccessibility="no"/>
    </com.google.android.material.card.MaterialCardView>
    <TextView
        android:textSize="16sp"
        android:textColor="?android:attr/textColorPrimary"
        android:id="@+id/ringtone_primary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textDirection="locale"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toTopOf="@+id/ringtone_secondary_text"
        app:layout_constraintEnd_toStartOf="@+id/sound_image_playing"
        app:layout_constraintStart_toEndOf="@+id/ringtone_image_container"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="packed"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/ringtone_secondary_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textDirection="locale"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sound_image_playing"
        app:layout_constraintStart_toEndOf="@+id/ringtone_image_container"
        app:layout_constraintTop_toBottomOf="@+id/ringtone_primary_text"/>
    <ImageView
        android:id="@+id/sound_image_playing"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:contentDescription="@string/playing"
        android:paddingEnd="16dp"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/sound_image_selected"
        app:layout_constraintTop_toTopOf="parent"
        app:tint="?android:attr/textColorSecondary"
        app:tintMode="src_in"/>
    <ImageView
        android:id="@+id/sound_image_selected"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/music_actions"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/selector_checkbox_selected"
        app:tint="?attr/colorAccent"
        app:tintMode="src_in"/>
    <ImageButton
        android:id="@+id/music_actions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:scaleType="center"
        android:minWidth="@dimen/google_min_touch_target_size"
        android:minHeight="@dimen/google_min_touch_target_size"
        android:layout_centerVertical="true"
        android:contentDescription="@string/more_options"
        android:scaleX="0.75"
        android:scaleY="0.75"
        android:layout_alignParentEnd="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/end_guide_very_thin"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/ic_more_vert_24dp"
        app:tint="?android:attr/textColorSecondary"
        app:tintMode="src_in"/>
</androidx.constraintlayout.widget.ConstraintLayout>
