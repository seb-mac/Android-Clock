<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@drawable/timer_setting_background"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingHorizontal="16dp">
    <TextView
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:gravity="start|center_vertical"
        android:id="@+id/label_setting_title"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="52dp"
        android:text="@string/timer_label_setting_title"
        android:drawablePadding="16dp"
        android:drawableStart="@drawable/gs_label_fill1_vd_theme_24"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="end"
        android:id="@+id/timer_label"
        android:focusable="false"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/default_timer_label"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/label_setting_title"
        app:layout_constraintTop_toTopOf="parent"/>
    <EditText
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="end"
        android:id="@+id/timer_label_edit"
        android:visibility="gone"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hint="@string/default_timer_label"
        android:selectAllOnFocus="true"
        android:inputType="text"
        android:importantForAutofill="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/label_setting_title"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
