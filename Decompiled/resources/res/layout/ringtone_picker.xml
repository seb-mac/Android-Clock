<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.deskclock.widget.InsetRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/ringtone_content"
        android:scrollbars="vertical"
        android:saveEnabled="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
    <LinearLayout
        android:orientation="vertical"
        android:id="@+id/connection_error"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginBottom="18dp">
        <ScrollView
            android:scrollbarStyle="outsideOverlay"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">
            <LinearLayout
                android:gravity="center"
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp">
                <ImageView
                    android:id="@+id/connection_error_image"
                    android:focusable="false"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/music_provider_margin_top"/>
                <TextView
                    android:textSize="24sp"
                    android:textColor="@android:color/white"
                    android:id="@+id/connection_error_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textAlignment="center"/>
                <TextView
                    android:textSize="16sp"
                    android:id="@+id/connection_error_prompt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textAlignment="center"/>
                <ImageView
                    android:id="@+id/connection_error_provider_logo"
                    android:focusable="false"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="32dp"
                    android:scaleType="fitCenter"/>
            </LinearLayout>
        </ScrollView>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp">
            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:constraint_referenced_ids="provider_hide,provider_action"
                app:flow_horizontalStyle="spread_inside"
                app:flow_wrapMode="chain"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"/>
            <Button
                android:textAppearance="@style/TextAppearance.LabelGoogleMed"
                android:textColor="?attr/colorAccent"
                android:layout_gravity="start|bottom"
                android:id="@+id/provider_hide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hide_provider"
                android:textAllCaps="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                style="?attr/materialButtonOutlinedStyle"/>
            <Button
                android:textAppearance="@style/TextAppearance.LabelGoogleMed"
                android:layout_gravity="end|bottom"
                android:id="@+id/provider_action"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:paddingStart="32dp"
                android:paddingEnd="32dp"
                android:backgroundTint="?attr/colorAccent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:orientation="vertical"
        android:id="@+id/provider_unreachable"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp">
        <ImageView
            android:id="@+id/provider_unreachable_image"
            android:focusable="false"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_bias="0.2"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/white_25"
            android:id="@+id/provider_unreachable_prompt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textAlignment="center"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/provider_unreachable_image"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <ImageView
        android:id="@+id/connecting_indicator"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>
</FrameLayout>
