<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:theme="@style/Theme.DeskClock.StopwatchWidget"
    android:layout_gravity="center"
    android:id="@+id/stopwatch_layout"
    android:layout_width="@dimen/stopwatch_widget_default_size"
    android:layout_height="@dimen/stopwatch_widget_default_size">
    <FrameLayout
        android:id="@android:id/background"
        android:background="@drawable/stopwatch_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:backgroundTint="?android:attr/colorBackground"
        android:outlineProvider="background"
        android:clipToOutline="true"/>
    <Chronometer
        android:textAppearance="@style/TextAppearance.StopwatchAppWidget.Chronometer"
        android:textSize="32dp"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/stopwatch_chrono"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:text="@string/sw_chrono_preview"
        android:maxLines="1"
        android:includeFontPadding="false"/>
    <TextView
        android:textAppearance="@style/TextAppearance.StopwatchAppWidget.LapText"
        android:textSize="14dp"
        android:ellipsize="none"
        android:gravity="center"
        android:layout_gravity="bottom|center_horizontal"
        android:id="@+id/stopwatch_lap_textview"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/stopwatch_widget_start_pause_size"
        android:maxLines="1"
        android:drawablePadding="0dp"
        android:drawableTint="@color/stopwatch_widget_lap_count"/>
    <LinearLayout
        android:layout_gravity="end|top"
        android:orientation="horizontal"
        android:background="@drawable/stopwatch_toolbar_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <ImageButton
            android:id="@+id/stopwatch_add_lap"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:src="@drawable/quantum_gm_ic_timer_vd_theme_24"
            android:tint="@color/stopwatch_widget_toolbar_action"
            android:contentDescription="@string/sw_lap_button"/>
        <ImageButton
            android:id="@+id/stopwatch_reset"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:src="@drawable/quantum_gm_ic_restart_alt_vd_theme_24"
            android:tint="@color/stopwatch_widget_toolbar_action"
            android:contentDescription="@string/sw_reset_button"/>
    </LinearLayout>
    <ImageButton
        android:gravity="center"
        android:layout_gravity="start|bottom"
        android:id="@+id/stopwatch_start_pause"
        android:background="@drawable/stopwatch_start_pause_background"
        android:layout_width="@dimen/stopwatch_widget_start_pause_size"
        android:layout_height="@dimen/stopwatch_widget_start_pause_size"
        android:src="@drawable/gs_play_arrow_fill1_vd_theme_24"
        android:tint="@color/stopwatch_widget_play_pause_button"
        android:contentDescription="@string/stopwatch_widget_start_button_content_description"/>
</FrameLayout>
