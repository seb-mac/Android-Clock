<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:maxWidth="@dimen/gesture_dialog_max_width"
    android:maxHeight="@dimen/gesture_dialog_max_height"
    style="@style/ChooseAlarmDismissGestureContainerStyle">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_start_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_end_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_top_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_bottom_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_gap_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_gap_start_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_gap_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_gap_end_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_title_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_title_bottom_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_preview_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_preview_top_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_preview_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_preview_bottom_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_card_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_top_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_card_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_bottom_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_card_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_start_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gesture_dialog_card_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_end_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_card_describe_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_describe_top_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_card_describe_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_card_describe_bottom_guideline_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gesture_dialog_button_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/gesture_dialog_button_top_guideline_percent"/>
    <TextView
        android:gravity="center"
        android:id="@+id/dialog_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="0dp"
        android:text="@string/choose_alarm_dismiss_gesture_dialog_title"
        app:layout_constraintBottom_toTopOf="@+id/gesture_dialog_title_bottom_guideline"
        app:layout_constraintEnd_toEndOf="@+id/gesture_dialog_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/gesture_dialog_start_guideline"
        app:layout_constraintTop_toTopOf="@+id/gesture_dialog_top_guideline"
        style="@style/ChooseAlarmDismissGestureTitleStyle"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/preview_container"
        android:visibility="visible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/gesture_dialog_preview_bottom_guideline"
        app:layout_constraintDimensionRatio="H,8:6"
        app:layout_constraintEnd_toEndOf="@+id/gesture_dialog_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/gesture_dialog_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/gesture_dialog_preview_top_guideline"
        app:layout_constraintWidth_max="340dp"
        style="@style/ChooseAlarmDismissGesturePreviewContainerStyle">
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/preview_container_top"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.33"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="horizontal"
            android:id="@+id/preview_container_bottom"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.66"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/preview_container_start"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.04"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/preview_container_end"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="0.96"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/preview_component"
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/preview_container_bottom"
            app:layout_constraintEnd_toEndOf="@+id/preview_container_end"
            app:layout_constraintStart_toStartOf="@+id/preview_container_start"
            app:layout_constraintTop_toBottomOf="@+id/preview_container_top"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_tap"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/dismiss_alarm_gesture_setting_tap"
        app:layout_constraintBottom_toTopOf="@+id/gesture_dialog_card_describe_bottom_guideline"
        app:layout_constraintEnd_toStartOf="@+id/gesture_dialog_gap_start_guideline"
        app:layout_constraintStart_toStartOf="@+id/gesture_dialog_card_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/gesture_dialog_card_top_guideline">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_tap"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:contentPadding="8dp"
            app:layout_constraintBottom_toTopOf="@+id/card_tap_text"
            app:layout_constraintDimensionRatio="H,7:6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="140dp"
            style="@style/ChooseAlarmDismissGestureCardContainerStyle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:id="@+id/card_tap_snooze"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_thumb_tap_snooze"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    android:layout_marginEnd="4dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@+id/card_tap_dismiss"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
                <ImageView
                    android:id="@+id/card_tap_dismiss"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_thumb_tap_stop"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintHorizontal_weight="1"
                    app:layout_constraintStart_toEndOf="@+id/card_tap_snooze"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/card_tap_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dismiss_alarm_gesture_setting_tap"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_tap"
            style="@style/ChooseAlarmDismissGestureCardTextStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/container_swipe"
        android:focusable="true"
        android:clickable="true"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:contentDescription="@string/dismiss_alarm_gesture_setting_swipe"
        app:layout_constraintBottom_toTopOf="@+id/gesture_dialog_card_describe_bottom_guideline"
        app:layout_constraintEnd_toEndOf="@+id/gesture_dialog_card_end_guideline"
        app:layout_constraintStart_toEndOf="@+id/gesture_dialog_gap_end_guideline"
        app:layout_constraintTop_toBottomOf="@+id/gesture_dialog_card_top_guideline">
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_swipe"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="no"
            app:contentPadding="8dp"
            app:layout_constraintBottom_toTopOf="@+id/card_swipe_text"
            app:layout_constraintDimensionRatio="H,7:6"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed"
            app:layout_constraintWidth_max="140dp"
            style="@style/ChooseAlarmDismissGestureCardContainerStyle">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_gravity="center"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_thumb_swipe_alarm"
                    android:scaleType="fitCenter"
                    android:adjustViewBounds="true"
                    android:importantForAccessibility="no"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintTop_toTopOf="parent"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>
        <TextView
            android:id="@+id/card_swipe_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/dismiss_alarm_gesture_setting_swipe"
            android:importantForAccessibility="no"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_swipe"
            style="@style/ChooseAlarmDismissGestureCardTextStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_cancel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/cancel"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/btn_ok"
        app:layout_constraintEnd_toStartOf="@+id/btn_ok"
        app:layout_constraintTop_toTopOf="@+id/btn_ok"
        style="@style/ChooseAlarmDismissGestureCancelButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btn_ok"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/ok"
        app:layout_constraintBottom_toBottomOf="@+id/gesture_dialog_bottom_guideline"
        app:layout_constraintEnd_toEndOf="@+id/gesture_dialog_end_guideline"
        app:layout_constraintTop_toBottomOf="@+id/gesture_dialog_button_top_guideline"
        style="@style/ChooseAlarmDismissGestureOkButtonStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
