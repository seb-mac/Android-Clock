<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/timer_card_state_deskclock_landscape">
    <Constraint android:id="@+id/timer_track_spacer">
        <Layout
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_track"
            app:layout_constraintHorizontal_bias="0"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/timer_track_spacer_vert"
            app:layout_constraintVertical_bias="1"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/play_pause"
            app:layout_constraintHorizontal_weight="2"
            app:layout_constraintStart_toEndOf="@+id/timer_track_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"
            app:layout_constraintVertical_bias="0.5"/>
    </Constraint>
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="-8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x800013"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_start">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toStartOf="@+id/timer_text"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toStartOf="@+id/timer_text_spacer_end"
            app:layout_constraintHorizontal_weight="76"
            app:layout_constraintStart_toEndOf="@+id/timer_text_spacer_start"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_end">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toEndOf="@+id/timer_text"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginStart="12dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="H,3:2"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintHorizontal_bias="1"
            app:layout_constraintHorizontal_weight="1.1"
            app:layout_constraintStart_toEndOf="@+id/timer_track"
            app:layout_constraintVertical_bias="1"/>
    </Constraint>
    <Constraint android:id="@+id/primary_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toTopOf="@+id/play_pause"
            app:layout_constraintDimensionRatio="H,3:2"
            app:layout_constraintEnd_toEndOf="@+id/play_pause"
            app:layout_constraintStart_toStartOf="@+id/play_pause"
            app:layout_constraintTop_toBottomOf="@+id/tertiary_button"
            app:layout_constraintVertical_bias="1"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/secondary_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginBottom="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toBottomOf="@+id/timer_text"
            app:layout_constraintVertical_bias="0.2"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/tertiary_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="-12dp"
            android:layout_marginEnd="-12dp"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintTop_toBottomOf="@+id/tertiary_button_spacer"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
</ConstraintSet>
