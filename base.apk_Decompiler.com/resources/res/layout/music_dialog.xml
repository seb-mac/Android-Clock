<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="@dimen/material_corner_radius">
    <androidx.core.widget.NestedScrollView
        android:scrollbars="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:textSize="24sp"
                android:textColor="?attr/colorOnSurface"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="4dp"
                android:text="@string/music_alert_header"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"/>
            <TextView
                android:textSize="14sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:text="@string/music_alert_description"
                android:layout_marginStart="24dp"
                android:layout_marginEnd="24dp"
                android:lineHeight="24dp"/>
            <android.support.v7.widget.RecyclerView
                android:scrollbarStyle="outsideOverlay"
                android:id="@+id/music_provider_apps"
                android:scrollbars="vertical"
                android:saveEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:overScrollMode="never"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"/>
            <LinearLayout
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:textSize="12sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/get_it_on_google_play"
                    android:visibility="invisible"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/get_it_on_google_play"
                    android:layout_weight="1"
                    android:layout_marginStart="24dp"/>
                <Button
                    android:textSize="14sp"
                    android:layout_gravity="center_vertical"
                    android:id="@+id/dismiss"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:text="@string/dismiss"
                    android:textAllCaps="false"
                    android:fontFamily="@font/google_sans_medium_compat"
                    android:layout_marginEnd="24dp"
                    style="?attr/materialButtonOutlinedStyle"/>
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</com.google.android.material.card.MaterialCardView>
