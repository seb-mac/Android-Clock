<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/center_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <TextView
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:id="@+id/bedtime_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bedtime_schedule_clock_margin_top"
        android:text="@string/menu_bedtime"
        android:textAllCaps="true"
        android:importantForAccessibility="no"
        android:fontFamily="@font/google_sans_compat"
        app:layout_constraintEnd_toStartOf="@+id/center_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.deskclock.common.ui.texttime.TextTime
        android:textAppearance="@style/TextAppearance.TextClock"
        android:gravity="center"
        android:id="@+id/bedtime_clock"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toTopOf="@+id/sleep_duration"
        app:layout_constraintEnd_toStartOf="@+id/center_guide"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bedtime_label"/>
    <TextView
        android:textSize="11sp"
        android:textColor="?android:attr/textColorSecondary"
        android:gravity="center"
        android:id="@+id/wake_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/bedtime_schedule_clock_margin_top"
        android:text="@string/bedtime_wake"
        android:textAllCaps="true"
        android:importantForAccessibility="no"
        android:fontFamily="@font/google_sans_compat"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/center_guide"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.android.deskclock.common.ui.texttime.TextTime
        android:textAppearance="@style/TextAppearance.TextClock"
        android:gravity="center"
        android:id="@+id/wake_clock"
        android:background="?attr/selectableItemBackground"
        android:focusable="true"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="1"
        app:layout_constraintBottom_toBottomOf="@+id/bedtime_clock"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/center_guide"
        app:layout_constraintTop_toTopOf="@+id/bedtime_clock"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?android:attr/textColorSecondary"
        android:id="@+id/sleep_duration"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:fontFamily="@font/google_sans_compat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bedtime_clock"/>
</androidx.constraintlayout.widget.ConstraintLayout>
