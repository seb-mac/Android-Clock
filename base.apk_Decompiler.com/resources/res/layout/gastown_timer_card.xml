<?xml version="1.0" encoding="utf-8"?>
<com.android.deskclock.timer.gastown.ui.GastownTimerCard xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:importantForAccessibility="no"
    app:layoutDescription="@xml/gastown_timer_card_scene">
    <View
        android:id="@+id/timer_background"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        android:clipToOutline="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/timer_track"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:indeterminate="false"
        android:importantForAccessibility="no"
        app:indicatorColor="?attr/colorPrimary"
        app:indicatorSize="@dimen/timer_track_progress_indicator_size"
        app:indicatorTrackGapSize="@dimen/timer_track_progress_indicator_gap_size"
        app:trackColor="?attr/colorOutlineVariant"
        app:trackCornerRadius="@dimen/timer_track_corner_radius"
        app:trackThickness="@dimen/timer_track_thickness"/>
    <ImageView
        android:id="@+id/timer_track_expired"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:src="@drawable/timer_expired_round"
        android:scaleType="fitXY"
        android:importantForAccessibility="no"/>
    <TextView
        android:textAppearance="?attr/textAppearanceBodyLarge"
        android:textSize="16sp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="end"
        android:gravity="center"
        android:id="@+id/timer_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:textAppearance="@style/GastownTimerCountdownTextPausedStyle"
        android:textSize="80sp"
        android:textColor="?attr/colorOnSurface"
        android:ellipsize="none"
        android:gravity="center"
        android:id="@+id/timer_text"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:includeFontPadding="false"
        android:fontFeatureSettings="tnum"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/add_one_min_button_end_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.68"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/land_track_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/track_button_divider"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.7"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/expired_top_timer_text_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.2"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/expired_bottom_timer_text_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.45"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/expired_top_timer_label_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.45"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/expired_bottom_timer_label_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.6"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/expired_button_top_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.8"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gastown_track_start"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:guidelineUseRtl="true"
        app:layout_constraintGuide_percent="0.1"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gastown_track_end"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:guidelineUseRtl="true"
        app:layout_constraintGuide_percent="0.9"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gastown_bottom_gutter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.95"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/reset_button_start_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.38"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/reset_button_end_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.62"/>
    <Space
        android:id="@+id/delete_button_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/delete_button_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/delete_button_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/delete_button_spacer_vert"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/delete_button_spacer_horiz"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <Space
        android:id="@+id/timer_label_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"/>
    <Space
        android:id="@+id/timer_label_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/timer_label_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/timer_label_spacer_vert"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/timer_label_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0"/>
    <Space
        android:id="@+id/timer_track_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_percent="@dimen/timer_card_spacer_size"
        app:layout_constraintStart_toStartOf="parent"/>
    <Space
        android:id="@+id/timer_track_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="@dimen/timer_card_spacer_size"/>
    <Space
        android:id="@+id/timer_track_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/timer_track_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/timer_track_spacer_vert"
        app:layout_constraintVertical_bias="1"/>
    <Space
        android:id="@+id/timer_text_spacer_start"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <Space
        android:id="@+id/timer_text_spacer_end"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <Space
        android:id="@+id/vertical_spacer_between_label_and_button"
        android:layout_width="0dp"
        android:layout_height="0dp"/>
    <Space
        android:id="@+id/portrait_spacer_between_add_one_min_and_reset_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constrainedWidth="true"
        app:layout_constraintBottom_toTopOf="@+id/gastown_bottom_gutter"
        app:layout_constraintEnd_toStartOf="@+id/reset_button"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/add_one_min_button"
        app:layout_constraintTop_toBottomOf="@+id/timer_track"
        app:layout_constraintWidth_max="6dp"
        app:layout_constraintWidth_min="2dp"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/reset_button"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeTextType="uniform"
        app:borderWidth="0dp"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconTint="?attr/colorOnSurface"
        style="@style/GastownTimerButtonStyleBase"/>
    <Space
        android:id="@+id/add_one_min_button_spacer_vert"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reset_button"
        app:layout_constraintHeight_percent="0.075"
        app:layout_constraintStart_toEndOf="@+id/reset_button"/>
    <Space
        android:id="@+id/add_one_min_button_spacer_horiz"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reset_button"
        app:layout_constraintStart_toEndOf="@+id/reset_button"
        app:layout_constraintWidth_percent="0.075"/>
    <Space
        android:id="@+id/add_one_min_button_spacer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/reset_button"
        app:layout_constraintDimensionRatio="1:1"
        app:layout_constraintEnd_toEndOf="@+id/add_one_min_button_spacer_horiz"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toEndOf="@+id/reset_button"
        app:layout_constraintTop_toTopOf="@+id/add_one_min_button_spacer_vert"
        app:layout_constraintVertical_bias="1"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/add_one_min_button"
        android:padding="4dp"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:maxLines="1"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:autoSizeMaxTextSize="24sp"
        app:autoSizeMinTextSize="6sp"
        app:autoSizeTextType="uniform"
        app:borderWidth="0dp"
        app:cornerRadius="512dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        style="@style/GastownTimerButtonStyleBase"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/play_pause_button"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:insetLeft="6dp"
        android:insetRight="6dp"
        android:insetTop="4dp"
        android:insetBottom="8dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        app:iconSize="@dimen/timer_play_pause_icon_size"
        app:iconTint="?attr/colorOnSurface"
        style="?attr/materialIconButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/delete_button"
        android:layout_width="@dimen/google_min_touch_target_size"
        android:layout_height="@dimen/google_min_touch_target_size"
        android:layout_marginTop="-12dp"
        android:insetLeft="12dp"
        android:insetRight="12dp"
        android:insetTop="12dp"
        android:insetBottom="12dp"
        android:layout_marginEnd="-12dp"
        app:iconGravity="textStart"
        app:iconPadding="0dp"
        style="?attr/materialIconButtonStyle"/>
</com.android.deskclock.timer.gastown.ui.GastownTimerCard>
