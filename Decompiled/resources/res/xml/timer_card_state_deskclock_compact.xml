<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timer_card_state_deskclock_compact"
    app:deriveConstraintsFrom="@+id/timer_card_state_deskclock_landscape">
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="-8dp"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x800013"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="6dp"
            android:minHeight="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toTopOf="@+id/bottom_gutter"
            app:layout_constraintEnd_toStartOf="@+id/secondary_button"
            app:layout_constraintHorizontal_chainStyle="spread_inside"
            app:layout_constraintHorizontal_weight="3"
            app:layout_constraintStart_toEndOf="@+id/timer_label_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label"/>
    </Constraint>
    <Constraint android:id="@+id/secondary_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toStartOf="@+id/primary_button"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/timer_text"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintDimensionRatio="W,3:2"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/primary_button"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/primary_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintDimensionRatio="Ｗ,3:2"
            app:layout_constraintEnd_toStartOf="@+id/play_pause"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/secondary_button"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/tertiary_button">
        <Layout
            android:layout_width="@dimen/google_min_touch_target_size"
            android:layout_height="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toBottomOf="@+id/timer_label"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintTop_toTopOf="@+id/timer_label"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track">
        <PropertySet android:visibility="gone"/>
    </Constraint>
</ConstraintSet>
