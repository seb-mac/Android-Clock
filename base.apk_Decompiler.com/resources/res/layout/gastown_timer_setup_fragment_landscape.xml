<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/gastown_timer_setup_fragment_landscape"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_start_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.04"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_end_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/timer_setup_center_vertical_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/timer_display_bottom_guideline"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@dimen/timer_display_bottom_guideline_percent"/>
    <include
        android:id="@+id/gastown_timer_display_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_display_bottom_guideline"
        app:layout_constraintEnd_toEndOf="@+id/gastown_timer_action_view"
        app:layout_constraintStart_toStartOf="@+id/gastown_timer_action_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        layout="@layout/gastown_timer_display_view"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/gastown_timer_display_one_line"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:accessibilityLiveRegion="polite"
        app:layout_constraintBottom_toTopOf="@+id/timer_display_bottom_guideline"
        app:layout_constraintEnd_toEndOf="@+id/gastown_timer_action_view"
        app:layout_constraintStart_toStartOf="@+id/gastown_timer_action_view"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="1"
        style="@style/TimerSetupDisplayOneLine"/>
    <include
        android:id="@+id/gastown_timer_action_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timer_setup_center_vertical_guideline"
        app:layout_constraintStart_toStartOf="@+id/timer_setup_start_guideline"
        app:layout_constraintTop_toBottomOf="@+id/timer_display_bottom_guideline"
        app:layout_constraintVertical_bias="0"
        app:layout_constraintWidth_max="@dimen/timer_action_view_max_width"
        layout="@layout/gastown_timer_action_view"/>
    <include
        android:id="@+id/gastown_timer_keypad_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/timer_setup_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/timer_setup_center_vertical_guideline"
        app:layout_constraintTop_toTopOf="parent"
        layout="@layout/gastown_timer_keypad_view"/>
</androidx.constraintlayout.widget.ConstraintLayout>
