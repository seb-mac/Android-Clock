<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.deskclock.bedtime.ui.starfieldview.StarfieldView
        android:id="@+id/starfield"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:maxStarTimeMillis="10000"
        app:starColor="@android:color/white"
        app:starCount="800"/>
    <Space
        android:id="@+id/spacer"
        android:layout_width="0dp"
        android:layout_height="1px"
        app:layout_constraintBottom_toTopOf="@+id/sleep_sound_title"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_chainStyle="spread_inside"/>
    <TextView
        android:textSize="28sp"
        android:textColor="@android:color/white"
        android:gravity="center"
        android:id="@+id/sleep_sound_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/play_pause_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/spacer"/>
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:layout_gravity="center"
        android:id="@+id/play_pause_button"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toTopOf="@+id/stop_after_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/sleep_sound_title"
        app:tint="?attr/colorOnPrimary"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:gravity="center"
        android:id="@+id/stop_after_button"
        android:background="@drawable/stop_after_chip_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:drawablePadding="8dp"
        android:drawableStart="@null"
        android:drawableEnd="@null"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:drawableTint="?attr/colorOnSecondaryContainer"
        app:layout_constraintBottom_toTopOf="@+id/hint"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/play_pause_button"
        style="?attr/borderlessButtonStyle"/>
    <TextView
        android:textSize="@dimen/bottom_text_size"
        android:textStyle="italic"
        android:textColor="?attr/colorOutline"
        android:gravity="center"
        android:id="@+id/hint"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        app:layout_constraintBottom_toTopOf="@+id/select_another_sound"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/stop_after_button"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorAccent"
        android:gravity="center"
        android:id="@+id/select_another_sound"
        android:background="?attr/selectableItemBackground"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/google_min_touch_target_size"
        android:text="@string/select_another_sound"
        android:fontFamily="@font/google_sans_medium_compat"
        app:layout_constraintBottom_toTopOf="@+id/music_attribution_background"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/hint"/>
    <FrameLayout
        android:id="@+id/music_attribution_background"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="48dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/select_another_sound"/>
    <ImageView
        android:id="@+id/music_attribution_logo"
        android:layout_width="wrap_content"
        android:layout_height="18dp"
        android:scaleType="centerInside"
        android:adjustViewBounds="true"
        android:paddingStart="20dp"
        android:paddingEnd="10dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_attribution_background"
        app:layout_constraintEnd_toStartOf="@+id/music_information"
        app:layout_constraintHorizontal_chainStyle="spread_inside"
        app:layout_constraintStart_toStartOf="@+id/music_attribution_background"
        app:layout_constraintTop_toTopOf="@+id/music_attribution_background"/>
    <TextView
        android:textSize="@dimen/bottom_text_size"
        android:textColor="@android:color/white"
        android:gravity="end"
        android:id="@+id/music_information"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:paddingStart="10dp"
        android:paddingEnd="20dp"
        app:layout_constraintBottom_toBottomOf="@+id/music_attribution_background"
        app:layout_constraintEnd_toEndOf="@+id/music_attribution_background"
        app:layout_constraintStart_toEndOf="@+id/music_attribution_logo"
        app:layout_constraintTop_toTopOf="@+id/music_attribution_background"/>
</androidx.constraintlayout.widget.ConstraintLayout>
