<?xml version="1.0" encoding="utf-8"?>
<GridLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:gravity="center"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:rowCount="2"
    android:columnCount="2">
    <LinearLayout
        android:theme="@style/Theme.DeskClock.DigitalWidget"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/digital_cities_tile_background"
        android:padding="@dimen/cities_widget_preview_tile_padding"
        android:layout_width="@dimen/cities_widget_preview_tile_width"
        android:layout_height="@dimen/cities_widget_preview_tile_height"
        android:layout_marginEnd="@dimen/cities_widget_preview_tile_margin"
        android:backgroundTint="?android:attr/colorBackground">
        <TextView
            android:textAppearance="@style/TextAppearance.CityName"
            android:textSize="@dimen/cities_widget_preview_label_font_size"
            android:textColor="@color/appwidget_label_color"
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cities_widget_preview_city_mountain_view"
            android:singleLine="true"/>
        <TextClock
            android:textAppearance="@style/TextAppearance.DigitalAppWidget.TextClockPrimary"
            android:textSize="@dimen/cities_widget_preview_clock_font_size"
            android:ellipsize="none"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:format12Hour="@string/cities_appwidget_12_hour_format"
            android:format24Hour="@string/cities_appwidget_24_hour_format"
            android:timeZone="America/Los_Angeles"/>
        <TextClock
            android:textAppearance="@style/TextAppearance.DigitalAppWidget.Label"
            android:textSize="@dimen/cities_widget_preview_label_font_size"
            android:ellipsize="none"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:format12Hour="@string/am_pm_weekday_12hour"
            android:format24Hour="@string/am_pm_weekday_24hour"
            android:timeZone="America/Los_Angeles"/>
    </LinearLayout>
    <LinearLayout
        android:theme="@style/Theme.DeskClock.DigitalWidget"
        android:gravity="center"
        android:orientation="vertical"
        android:background="@drawable/digital_cities_tile_background"
        android:padding="@dimen/cities_widget_preview_tile_padding"
        android:layout_width="@dimen/cities_widget_preview_tile_width"
        android:layout_height="@dimen/cities_widget_preview_tile_height"
        android:backgroundTint="?android:attr/colorBackground">
        <TextView
            android:textAppearance="@style/TextAppearance.CityName"
            android:textSize="@dimen/cities_widget_preview_label_font_size"
            android:textColor="@color/appwidget_label_color"
            android:ellipsize="end"
            android:gravity="top|center_horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/cities_widget_preview_city_london"
            android:singleLine="true"/>
        <TextClock
            android:textAppearance="@style/TextAppearance.DigitalAppWidget.TextClockPrimary"
            android:textSize="@dimen/cities_widget_preview_clock_font_size"
            android:ellipsize="none"
            android:layout_gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:format12Hour="@string/cities_appwidget_12_hour_format"
            android:format24Hour="@string/cities_appwidget_24_hour_format"
            android:timeZone="Europe/London"/>
        <TextClock
            android:textAppearance="@style/TextAppearance.DigitalAppWidget.Label"
            android:textSize="@dimen/cities_widget_preview_label_font_size"
            android:ellipsize="none"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:singleLine="true"
            android:format12Hour="@string/am_pm_weekday_12hour"
            android:format24Hour="@string/am_pm_weekday_24hour"
            android:timeZone="Europe/London"/>
    </LinearLayout>
</GridLayout>
