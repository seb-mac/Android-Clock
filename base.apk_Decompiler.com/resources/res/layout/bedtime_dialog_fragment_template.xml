<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bedtime_dialog_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/bedtime_schedule_guidelines"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/drag_handle"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <LinearLayout
            android:id="@+id/bedtime_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:importantForAccessibility="no"
            app:layout_constraintStart_toStartOf="@+id/clock"
            app:layout_constraintTop_toBottomOf="@+id/drag_handle">
            <ImageView
                android:id="@+id/image"
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                app:tint="?android:attr/textColorSecondary"
                app:tintMode="src_in"/>
            <TextView
                android:textSize="11sp"
                android:textColor="?android:attr/textColorSecondary"
                android:gravity="center_vertical"
                android:id="@+id/label"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="18dp"
                android:textAllCaps="true"
                android:importantForAccessibility="no"
                android:fontFamily="@font/google_sans_compat"
                android:layout_marginStart="8dp"/>
        </LinearLayout>
        <include
            android:id="@+id/clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bedtime_label"
            layout="@layout/alarm_time_summary"/>
        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/toggle_switch"
            android:focusable="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"
            app:layout_constraintBottom_toBottomOf="@+id/clock"
            app:layout_constraintEnd_toEndOf="@+id/end_guide"
            app:layout_constraintTop_toTopOf="@+id/clock"/>
        <include
            android:id="@+id/repeat_days"
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/clock"
            layout="@layout/weekdays_selector"/>
        <View
            android:id="@+id/wakeup_preference_hairline"
            android:background="?attr/colorOutline"
            android:layout_width="0dp"
            android:layout_height="@dimen/hairline_size"
            android:layout_marginTop="16dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/repeat_days"/>
        <ViewStub
            android:id="@+id/bedtime_dialog_settings_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wakeup_preference_hairline"/>
        <TextView
            android:textSize="16sp"
            android:textColor="@color/disabled_color"
            android:gravity="center"
            android:id="@+id/disabled_explanation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/google_sans_medium_compat"
            android:paddingStart="36dp"
            android:paddingEnd="36dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/wakeup_preference_hairline"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
