<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:accessibilityLiveRegion="polite">
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/hour_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/hour_label"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/minute_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/timer_display_vertical_bias"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TimerSetupDurationTextStyle"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/minute_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/minute_label"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/hour_text"
        app:layout_constraintRight_toLeftOf="@+id/second_text"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/timer_display_vertical_bias"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TimerSetupDurationTextStyle"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/second_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@+id/second_label"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/minute_text"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="@dimen/timer_display_vertical_bias"
        app:layout_constraintVertical_chainStyle="packed"
        style="@style/TimerSetupDurationTextStyle"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/hour_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/label_hours_static"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toLeftOf="@+id/minute_label"
        app:layout_constraintTop_toBottomOf="@+id/hour_text"
        style="@style/TimerSetupDurationUnitStyle"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/minute_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/label_minutes_static"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/hour_label"
        app:layout_constraintRight_toLeftOf="@+id/second_label"
        app:layout_constraintTop_toBottomOf="@+id/minute_text"
        style="@style/TimerSetupDurationUnitStyle"/>
    <com.android.deskclock.common.ui.autosizingtextview.AutoSizingTextView
        android:id="@+id/second_label"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:text="@string/label_seconds_static"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintHeight_default="percent"
        app:layout_constraintHeight_percent="0.2"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintLeft_toRightOf="@+id/minute_label"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/second_text"
        style="@style/TimerSetupDurationUnitStyle"/>
</androidx.constraintlayout.widget.ConstraintLayout>
