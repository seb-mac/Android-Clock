<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.motion.widget.MotionLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/content"
    android:background="?attr/colorSurfaceContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layoutDirection="ltr"
    app:layoutDescription="@xml/gastown_alarm_activity_scene">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/horizontal_center"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gutter_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_left_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/gutter_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_right_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/gutter_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="0.96"/>
    <include layout="@layout/gastown_alarm_activity_sunrising"/>
    <include layout="@layout/gastown_alarm_activity_firing"/>
    <include layout="@layout/gastown_alarm_activity_snooze_dismiss_track"/>
    <include layout="@layout/gastown_alarm_activity_snooze_dismiss_buttons"/>
</androidx.constraintlayout.motion.widget.MotionLayout>
