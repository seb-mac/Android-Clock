<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:visibility="gone"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <Button
        android:id="@+id/bedtime_open_cough_snore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/bedtime_cough_snore_title"
        android:layout_marginStart="@dimen/bedtime_card_start_margin"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bedtime_cough_snore_consent_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <View
            android:id="@+id/bedtime_cough_snore_consent_separator"
            android:background="?android:attr/colorBackground"
            android:layout_width="0dp"
            android:layout_height="4dp"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <ImageView
            android:id="@+id/card_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:scaleType="fitCenter"
            android:importantForAccessibility="no"
            android:layout_marginHorizontal="19dp"
            android:layout_marginVertical="15dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/bedtime_cough_snore_consent_separator"
            app:srcCompat="@drawable/quantum_gm_ic_local_hotel_vd_theme_24"
            app:tint="?android:attr/textColorSecondary"
            app:tintMode="src_in"/>
        <TextView
            android:textSize="16sp"
            android:textColor="?android:attr/textColorPrimary"
            android:gravity="center_vertical"
            android:id="@+id/card_title"
            android:layout_width="0dp"
            android:layout_height="@dimen/google_min_touch_target_size"
            android:text="@string/bedtime_cough_snore_title"
            android:singleLine="true"
            android:fontFamily="@font/google_sans_medium_compat"
            android:textDirection="locale"
            android:layout_marginStart="19dp"
            app:layout_constraintStart_toEndOf="@+id/card_icon"
            app:layout_constraintTop_toBottomOf="@+id/bedtime_cough_snore_consent_separator"/>
        <include
            android:id="@+id/bedtime_cough_snore_consent"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/card_title"
            layout="@layout/bedtime_consent_view"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</FrameLayout>
