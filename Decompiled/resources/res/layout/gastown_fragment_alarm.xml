<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.android.deskclock.widget.AlarmRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/alarm_recycler_view"
        android:scrollbars="vertical"
        android:fadingEdgeLength="0dp"
        android:clipToPadding="false"
        android:descendantFocusability="beforeDescendants"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:splitMotionEvents="false"
        android:paddingHorizontal="@dimen/alarm_fragment_recycler_view_padding_horizontal"/>
    <com.android.deskclock.common.ui.tinttextview.TintTextView
        android:theme="@style/ThemeOverlay.Control.Secondary"
        android:textSize="28sp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:gravity="center_horizontal"
        android:layout_gravity="center"
        android:id="@+id/alarm_empty_view"
        android:paddingBottom="@dimen/tab_content_bottom_padding"
        android:visibility="gone"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_alarms"
        android:contentDescription="@string/no_alarms"
        app:drawableTint="?attr/colorOnSurfaceVariant"
        app:drawableTop="@drawable/ic_no_alarms_vd_32"/>
    <include layout="@layout/loading_indicator_view_stub"/>
</FrameLayout>
