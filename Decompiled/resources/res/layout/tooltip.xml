<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="16dp">
    <TextView
        android:textSize="16sp"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="4dp"
        android:fontFamily="@font/google_sans_medium_compat"/>
    <TextView
        android:textSize="14sp"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:id="@+id/body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="@font/google_sans_compat"/>
    <androidx.constraintlayout.widget.ConstraintLayout
        android:gravity="end|bottom"
        android:paddingTop="8dp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:gravity="start|bottom"
            android:id="@+id/dismiss_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/dismiss"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <TextView
            android:textSize="14sp"
            android:textColor="?attr/colorOnTertiaryContainer"
            android:gravity="end|bottom"
            android:id="@+id/positive_button"
            android:visibility="gone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/customize"
            app:layout_constraintBottom_toBottomOf="@+id/dismiss_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@+id/dismiss_button"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</LinearLayout>
