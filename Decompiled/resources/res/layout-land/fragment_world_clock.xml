<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/world_clock_fragment_land"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/start_guide"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_begin="@dimen/fragment_content_padding_horizontal"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/main_clock_area_end_guideline"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.52"/>
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/main_clock_area_end_guideline"
        app:layout_constraintStart_toStartOf="@+id/start_guide"
        app:layout_constraintTop_toTopOf="parent">
        <include
            android:id="@+id/gastown_main_clock_frame"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            layout="@layout/gastown_main_clock_frame"/>
    </androidx.core.widget.NestedScrollView>
    <com.android.deskclock.widget.DropShadowRecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/cities"
        android:paddingBottom="@dimen/list_view_padding_bottom_for_fab"
        android:scrollbars="vertical"
        android:clickable="false"
        android:clipToPadding="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:paddingEnd="22dp"
        android:layout_marginStart="12dp"
        app:dropShadow="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/main_clock_area_end_guideline"
        app:layout_constraintTop_toTopOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
