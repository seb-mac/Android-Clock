<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:foregroundGravity="center_horizontal">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">
        <com.android.deskclock.timer.gastown.ui.timersetup.MinutesPresetView
            android:id="@+id/timer_preset_1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/timer_preset_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_preset_2"
            app:layout_constraintHeight_max="80dp"
            app:layout_constraintHeight_min="80dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="80dp"
            app:layout_constraintWidth_min="80dp"
            app:time_digit="5"
            style="@style/SingleUnitTimerPresetViewShapeStyle"/>
        <com.android.deskclock.timer.gastown.ui.timersetup.MinutesPresetView
            android:id="@+id/timer_preset_2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/timer_preset_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_preset_3"
            app:layout_constraintHeight_max="80dp"
            app:layout_constraintHeight_min="80dp"
            app:layout_constraintStart_toEndOf="@+id/timer_preset_1"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="80dp"
            app:layout_constraintWidth_min="80dp"
            app:time_digit="10"
            style="@style/SingleUnitTimerPresetViewShapeStyle"/>
        <com.android.deskclock.timer.gastown.ui.timersetup.MinutesPresetView
            android:id="@+id/timer_preset_3"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/timer_preset_margin_end"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/timer_preset_4"
            app:layout_constraintHeight_max="80dp"
            app:layout_constraintHeight_min="80dp"
            app:layout_constraintStart_toEndOf="@+id/timer_preset_2"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="80dp"
            app:layout_constraintWidth_min="80dp"
            app:time_digit="30"
            style="@style/SingleUnitTimerPresetViewShapeStyle"/>
        <com.android.deskclock.timer.gastown.ui.timersetup.MinutesPresetView
            android:id="@+id/timer_preset_4"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHeight_max="80dp"
            app:layout_constraintHeight_min="80dp"
            app:layout_constraintStart_toEndOf="@+id/timer_preset_3"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintWidth_max="80dp"
            app:layout_constraintWidth_min="80dp"
            app:time_digit="45"
            style="@style/SingleUnitTimerPresetViewShapeStyle"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</HorizontalScrollView>
