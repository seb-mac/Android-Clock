<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/fold_guidelines"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/end_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_end_percent"/>
        <androidx.constraintlayout.widget.Guideline
            android:orientation="vertical"
            android:id="@+id/start_guide"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_start_percent"/>
        <LinearLayout
            android:orientation="vertical"
            android:id="@+id/bedtime_onboarding_header_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            style="@style/BedtimeOnboardingHeaderStyle">
            <ImageView
                android:layout_gravity="center"
                android:id="@+id/bedtime_label"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:importantForAccessibility="no"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="?attr/colorOnBackground"
                app:tintMode="src_in"/>
            <TextView
                android:textSize="24sp"
                android:textColor="?attr/colorOnBackground"
                android:gravity="center"
                android:id="@+id/bedtime_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:layout_marginHorizontal="24dp"/>
        </LinearLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/bedtime_onboarding_time_container"
            android:background="@drawable/background_round_top"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingVertical="16dp"
            app:layout_constraintBottom_toTopOf="@+id/bedtime_onboarding_settings_container"
            app:layout_constraintVertical_chainStyle="packed"
            style="@style/BedtimeOnboardingTimeStyle">
            <ImageView
                android:id="@+id/minus_button"
                android:background="@drawable/button_time_nudge_bg"
                android:padding="12dp"
                android:layout_width="@dimen/google_min_touch_target_size"
                android:layout_height="@dimen/google_min_touch_target_size"
                android:contentDescription="@string/bedtime_onboarding_minus_description"
                app:layout_constraintBottom_toBottomOf="@+id/target_clock"
                app:layout_constraintEnd_toStartOf="@+id/target_clock"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/target_clock"
                app:srcCompat="@drawable/quantum_gm_ic_remove_vd_theme_24"
                app:tint="?attr/colorOnSurfaceVariant"
                app:tintMode="src_in"/>
            <include
                android:id="@+id/target_clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="4dp"
                app:layout_constraintEnd_toStartOf="@+id/plus_button"
                app:layout_constraintStart_toEndOf="@+id/minus_button"
                app:layout_constraintTop_toTopOf="parent"
                layout="@layout/alarm_time_summary"/>
            <ImageView
                android:id="@+id/plus_button"
                android:background="@drawable/button_time_nudge_bg"
                android:padding="12dp"
                android:layout_width="@dimen/google_min_touch_target_size"
                android:layout_height="@dimen/google_min_touch_target_size"
                android:contentDescription="@string/bedtime_onboarding_plus_description"
                app:layout_constraintBottom_toBottomOf="@+id/target_clock"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/target_clock"
                app:layout_constraintTop_toTopOf="@+id/target_clock"
                app:srcCompat="@drawable/quantum_gm_ic_add_vd_theme_24"
                app:tint="?attr/colorOnSurfaceVariant"
                app:tintMode="src_in"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/colorOnBackground"
                android:id="@+id/sleep_duration"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/google_sans_compat"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/target_clock"/>
            <include
                android:id="@+id/repeat_days"
                android:layout_width="0dp"
                android:layout_height="@dimen/google_min_touch_target_size"
                android:layout_marginTop="16dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/sleep_duration"
                layout="@layout/weekdays_selector"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <ViewStub
            android:id="@+id/bedtime_onboarding_settings_container"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintBottom_toTopOf="@+id/bedtime_onboarding_skip"
            app:layout_constraintTop_toBottomOf="@+id/bedtime_onboarding_time_container"
            style="@style/BedtimeOnboardingSettingStyle"/>
        <androidx.constraintlayout.helper.widget.Flow
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/onboarding_button_area_top"
            android:layout_marginBottom="@dimen/onboarding_button_area_bottom"
            android:layout_marginStart="@dimen/onboarding_button_area_start"
            android:layout_marginEnd="@dimen/onboarding_button_area_end"
            app:constraint_referenced_ids="bedtime_onboarding_skip,bedtime_onboarding_next"
            app:flow_horizontalStyle="spread_inside"
            app:flow_wrapMode="chain"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>
        <Button
            android:id="@+id/bedtime_onboarding_skip"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/onboarding_button_width"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/skip"
            android:textAllCaps="false"
            style="?attr/materialButtonOutlinedStyle"/>
        <Button
            android:id="@+id/bedtime_onboarding_next"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="@dimen/onboarding_button_width"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:text="@string/next"
            android:textAllCaps="false"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
