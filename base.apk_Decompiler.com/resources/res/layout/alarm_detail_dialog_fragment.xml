<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <include layout="@layout/centered_guidelines"/>
        <ImageView
            android:id="@+id/drag_handle"
            android:layout_width="60dp"
            android:layout_height="4dp"
            android:layout_marginTop="12dp"
            android:src="@drawable/drag_handle"
            android:importantForAccessibility="no"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <com.google.android.material.loadingindicator.LoadingIndicator
            android:id="@+id/loading_indicator"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"/>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/clock_container"
            android:visibility="invisible"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="@dimen/alarm_detail_clock_container_padding_horizontal"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/drag_handle">
            <com.android.deskclock.common.ui.texttime.TextTime
                android:id="@+id/clock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="@style/AlarmDetailDialogAlarmTimeStyle"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="?attr/colorOnSurface"
                android:id="@+id/clock_edit_button"
                android:focusable="true"
                android:clickable="true"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:text="@string/alarm_edit"
                android:paddingHorizontal="@dimen/alarm_detail_button_padding_horizontal"
                app:backgroundTint="?attr/colorSurfaceBright"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/materialButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <com.android.deskclock.gastown.widget.GastownWeekdaysSelector
            android:id="@+id/repeat_days"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_thin"
            app:layout_constraintStart_toEndOf="@+id/start_guide_thin"
            app:layout_constraintTop_toBottomOf="@+id/clock_container"/>
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/schedule_alarm_row"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minWidth="@dimen/google_min_touch_target_size"
            android:minHeight="@dimen/google_min_touch_target_size"
            android:paddingHorizontal="16dp"
            app:flexWrap="wrap"
            app:justifyContent="flex_start"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_thin"
            app:layout_constraintStart_toEndOf="@+id/start_guide_thin"
            app:layout_constraintTop_toBottomOf="@+id/repeat_days">
            <LinearLayout
                android:gravity="start|center_vertical"
                android:orientation="vertical"
                android:id="@+id/schedule_alarm_details"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size">
                <TextView
                    android:textAppearance="@style/TextAppearance.Body"
                    android:gravity="start|center_vertical"
                    android:id="@+id/schedule_alarm_detail_1"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/icon_margin"/>
                <TextView
                    android:textAppearance="@style/TextAppearance.Body"
                    android:gravity="start|center_vertical"
                    android:id="@+id/schedule_alarm_detail_2"
                    android:background="?attr/selectableItemBackground"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="@dimen/icon_margin"/>
            </LinearLayout>
            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                app:layout_flexGrow="1"/>
            <TextView
                android:textAppearance="@style/TextAppearance.Body"
                android:gravity="end|center_vertical"
                android:id="@+id/schedule_alarm_action"
                android:background="?attr/selectableItemBackground"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:text="@string/schedule_alarm"
                android:drawablePadding="@dimen/alarm_horizontal_padding"
                android:drawableStart="@drawable/gs_calendar_clock_fill1rond100_vd_theme_24"/>
        </com.google.android.flexbox.FlexboxLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/settings_group"
            android:visibility="invisible"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_thin"
            app:layout_constraintStart_toEndOf="@+id/start_guide_thin"
            app:layout_constraintTop_toBottomOf="@+id/schedule_alarm_row">
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/pause_dismiss_setting_group"
                android:background="@drawable/background_alarm_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toTopOf="parent">
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/pause_alarm_row"
                    android:background="@drawable/background_alarm_setting_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="@dimen/alarm_horizontal_padding"
                    app:layout_constraintTop_toTopOf="parent">
                    <ImageView
                        android:layout_gravity="center_vertical"
                        android:id="@+id/pause_alarm_icon"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/gs_snooze_fill1rond100_vd_theme_24"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:importantForAccessibility="no"
                        android:paddingHorizontal="@dimen/icon_margin"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/pause_alarm_details"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <LinearLayout
                        android:orientation="vertical"
                        android:id="@+id/pause_alarm_details"
                        android:padding="12dp"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        app:layout_constraintEnd_toStartOf="@+id/pause_alarm_action"
                        app:layout_constraintStart_toEndOf="@+id/pause_alarm_icon"
                        app:layout_constraintTop_toTopOf="parent">
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body"
                            android:gravity="start|center_vertical"
                            android:id="@+id/pause_alarm_detail_1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"/>
                        <TextView
                            android:textAppearance="@style/TextAppearance.Body"
                            android:gravity="start|center_vertical"
                            android:id="@+id/pause_alarm_detail_2"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/alarm_edit"
                            android:layout_weight="1"/>
                    </LinearLayout>
                    <FrameLayout
                        android:id="@+id/pause_alarm_action"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent">
                        <com.google.android.material.button.MaterialButton
                            android:textColor="?attr/colorOnSurface"
                            android:id="@+id/pause_alarm_cancel_button"
                            android:focusable="true"
                            android:clickable="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minWidth="@dimen/google_min_touch_target_size"
                            android:minHeight="@dimen/google_min_touch_target_size"
                            android:text="@string/cancel"
                            android:paddingHorizontal="@dimen/alarm_detail_button_padding_horizontal"
                            app:backgroundTint="?attr/colorSurfaceBright"
                            style="?attr/materialButtonStyle"/>
                        <ImageView
                            android:id="@+id/pause_alarm_add_icon"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:importantForAccessibility="no"/>
                    </FrameLayout>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/alarm_setting_group"
                android:background="@drawable/background_alarm_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/pause_dismiss_setting_group">
                <com.google.android.flexbox.FlexboxLayout
                    android:id="@+id/label_setting"
                    android:background="@drawable/background_alarm_setting_item"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:foreground="?attr/selectableItemBackground"
                    android:minHeight="@dimen/google_min_touch_target_size"
                    android:paddingHorizontal="@dimen/alarm_horizontal_padding"
                    app:flexWrap="wrap"
                    app:justifyContent="flex_start"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="start|center_vertical"
                        android:id="@+id/label_setting_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:text="@string/alarm_label_setting_title"
                        android:drawablePadding="@dimen/alarm_horizontal_padding"
                        android:drawableStart="@drawable/gs_label_fill1rond100_vd_theme_24"
                        android:paddingHorizontal="@dimen/icon_margin"/>
                    <Space
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        app:layout_flexGrow="1"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="end|center_vertical"
                        android:id="@+id/alarm_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:hint="@string/default_alarm_label"
                        android:paddingHorizontal="@dimen/icon_margin"/>
                    <EditText
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="end|center_vertical"
                        android:id="@+id/alarm_label_edit"
                        android:visibility="gone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:hint="@string/default_alarm_label"
                        android:selectAllOnFocus="true"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/icon_margin"
                        android:importantForAutofill="no"/>
                </com.google.android.flexbox.FlexboxLayout>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/ringtone_setting"
                    android:background="@drawable/background_alarm_setting_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/label_setting">
                    <View
                        android:id="@+id/ringtone_promo_anchor"
                        android:visibility="invisible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="start|center_vertical"
                        android:id="@+id/ringtone_setting_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:text="@string/ringtone_label"
                        android:drawablePadding="@dimen/alarm_horizontal_padding"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="end|center_vertical"
                        android:id="@+id/alarm_ringtone"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@+id/ringtone_setting_title"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textAppearance="@style/TextAppearance.Body"
                    android:id="@+id/watch_alarm_sound"
                    android:background="@drawable/background_alarm_setting_item"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@android:color/transparent"
                    android:text="@string/ringtone_label"
                    android:drawablePadding="@dimen/alarm_horizontal_padding"
                    android:drawableStart="@drawable/quantum_gm_ic_notifications_active_vd_theme_24"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/ringtone_setting"/>
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textAppearance="@style/TextAppearance.Body"
                    android:id="@+id/vibrate"
                    android:background="@drawable/background_alarm_setting_item"
                    android:focusable="true"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:button="@android:color/transparent"
                    android:text="@string/alarm_vibrate"
                    android:drawablePadding="@dimen/alarm_horizontal_padding"
                    android:drawableStart="@drawable/gs_mobile_vibrate_fill1rond100_vd_theme_24"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintTop_toBottomOf="@+id/watch_alarm_sound"/>
            </androidx.constraintlayout.widget.ConstraintLayout>
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/integration_setting_group"
                android:background="@drawable/background_alarm_setting_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:layout_constraintTop_toBottomOf="@+id/alarm_setting_group">
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:textAppearance="@style/TextAppearance.Body"
                    android:id="@+id/weather_forecast"
                    android:background="@drawable/background_alarm_setting_item"
                    android:focusable="true"
                    android:visibility="gone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:button="@android:color/transparent"
                    android:text="@string/alarm_weather_forecast"
                    android:drawablePadding="@dimen/alarm_horizontal_padding"
                    android:drawableStart="@drawable/gs_rainy_fill1rond100_vd_theme_24"
                    android:paddingHorizontal="20dp"
                    app:layout_constraintTop_toTopOf="parent"/>
                <View
                    android:id="@+id/weather_forecast_promo_anchor"
                    android:visibility="invisible"
                    android:layout_width="60dp"
                    android:layout_height="0dp"
                    app:layout_constraintBottom_toBottomOf="@+id/weather_forecast"
                    app:layout_constraintEnd_toEndOf="@+id/weather_forecast"
                    app:layout_constraintTop_toTopOf="@+id/weather_forecast"/>
                <View
                    android:id="@+id/weather_forecast_error_anchor"
                    android:visibility="invisible"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_marginStart="31dp"
                    app:layout_constraintBottom_toBottomOf="@+id/weather_forecast"
                    app:layout_constraintStart_toStartOf="@+id/weather_forecast"
                    app:layout_constraintTop_toTopOf="@+id/weather_forecast"/>
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:id="@+id/assistant_routine_container"
                    android:background="@drawable/background_alarm_setting_item"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="20dp"
                    android:paddingEnd="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/weather_forecast">
                    <View
                        android:id="@+id/assistant_routine_promo_anchor"
                        android:visibility="invisible"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <TextView
                        android:textAppearance="@style/TextAppearance.Body"
                        android:gravity="start|center_vertical"
                        android:id="@+id/assistant_routine_setting_title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:minWidth="@dimen/google_min_touch_target_size"
                        android:minHeight="@dimen/google_min_touch_target_size"
                        android:text="@string/alarm_routines"
                        android:drawablePadding="@dimen/alarm_horizontal_padding"
                        android:drawableStart="@drawable/gs_button_magic_fill1rond100_vd_theme_24"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toStartOf="@+id/assistant_routine_button"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                    <ImageButton
                        android:id="@+id/assistant_routine_button"
                        android:background="?attr/selectableItemBackground"
                        android:layout_width="@dimen/google_min_touch_target_size"
                        android:layout_height="@dimen/google_min_touch_target_size"
                        android:scaleType="center"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"/>
                </androidx.constraintlayout.widget.ConstraintLayout>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingVertical="12dp"
            app:layout_constraintEnd_toStartOf="@+id/end_guide_thin"
            app:layout_constraintStart_toEndOf="@+id/start_guide_thin"
            app:layout_constraintTop_toBottomOf="@+id/settings_group">
            <com.google.android.material.button.MaterialButton
                android:textColor="?attr/colorError"
                android:id="@+id/delete_button"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:text="@string/delete_button_text"
                android:paddingHorizontal="@dimen/alarm_detail_button_padding_horizontal"
                app:backgroundTint="?attr/colorSurfaceBright"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/materialButtonStyle"/>
            <com.google.android.material.button.MaterialButton
                android:textColor="?attr/colorOnPrimary"
                android:id="@+id/save_button"
                android:visibility="invisible"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:minWidth="@dimen/google_min_touch_target_size"
                android:minHeight="@dimen/google_min_touch_target_size"
                android:text="@string/save_button_text"
                android:paddingHorizontal="@dimen/alarm_detail_button_padding_horizontal"
                app:backgroundTint="?attr/colorPrimary"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                style="?attr/materialButtonStyle"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
