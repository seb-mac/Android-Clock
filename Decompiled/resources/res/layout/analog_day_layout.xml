<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_frame"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <FrameLayout
        android:layout_gravity="center"
        android:id="@android:id/background"
        android:background="@drawable/analog_circle_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToOutline="true"/>
    <TextClock
        android:textColor="@android:color/transparent"
        android:id="@+id/a11y_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="@android:color/transparent"/>
    <TextClock
        android:theme="@style/Theme.DeskClock.AnalogWidget"
        android:textAppearance="@style/TextAppearance.AnalogClock.Day"
        android:gravity="center"
        android:layout_gravity="center"
        android:id="@+id/day_text_clock"
        android:background="@color/analog_appwidget_dial_number_color"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:importantForAccessibility="no"
        android:textAlignment="center"
        android:format12Hour="d"
        android:format24Hour="d"/>
    <AnalogClock
        android:theme="@style/Theme.DeskClock.AnalogWidget"
        android:id="@+id/base_clock"
        android:background="@android:color/transparent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:dial="@drawable/clock_analog_day_dial"
        android:hand_hour="@drawable/clock_analog_day_hour"
        android:hand_minute="@drawable/clock_analog_simple_minute"
        android:importantForAccessibility="no"
        android:hand_second="@drawable/clock_analog_simple_second"/>
</FrameLayout>
