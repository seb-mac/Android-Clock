<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/track_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_track_top_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/track_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_track_bottom_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/track_gutter_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_left_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/track_gutter_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_right_percent"/>
    <Space
        android:id="@+id/helper_snooze"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintEnd_toStartOf="@+id/helper_thumb"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toStartOf="@+id/track"
        app:layout_constraintTop_toTopOf="@+id/track"/>
    <Space
        android:id="@+id/helper_thumb"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintEnd_toStartOf="@+id/helper_dismiss"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/helper_snooze"
        app:layout_constraintTop_toTopOf="@+id/track"/>
    <Space
        android:id="@+id/helper_dismiss"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintEnd_toEndOf="@+id/track"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintStart_toEndOf="@+id/helper_thumb"
        app:layout_constraintTop_toTopOf="@+id/track"/>
    <FrameLayout
        android:id="@+id/track"
        android:background="@drawable/gastown_alarm_activity_track_drawable"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/track_gutter_right"
        app:layout_constraintHeight_max="96dp"
        app:layout_constraintHeight_min="@dimen/google_min_touch_target_size"
        app:layout_constraintStart_toStartOf="@+id/track_gutter_left"
        app:layout_constraintTop_toTopOf="@+id/track_top"
        app:layout_constraintWidth_max="600dp"/>
    <FrameLayout
        android:id="@+id/track_left"
        android:background="@drawable/gastown_alarm_activity_track_left_drawable"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/gastown_track_inset_thumb_margin"
        app:layout_constraintBottom_toBottomOf="@+id/thumb"
        app:layout_constraintEnd_toStartOf="@+id/track_right"
        app:layout_constraintStart_toStartOf="@+id/track"
        app:layout_constraintTop_toTopOf="@+id/thumb"/>
    <FrameLayout
        android:id="@+id/track_right"
        android:background="@drawable/gastown_alarm_activity_track_right_drawable"
        android:visibility="invisible"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="@dimen/gastown_track_inset_thumb_margin"
        app:layout_constraintBottom_toBottomOf="@+id/thumb"
        app:layout_constraintEnd_toEndOf="@+id/track"
        app:layout_constraintStart_toEndOf="@+id/track_left"
        app:layout_constraintTop_toTopOf="@+id/thumb"/>
    <TextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="start|center_vertical"
        android:id="@+id/snooze_drag_target"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minWidth="@dimen/google_min_touch_target_size"
        android:text="@string/alarm_alert_snooze_text"
        android:paddingStart="0dp"
        android:paddingEnd="8dp"
        android:layout_marginStart="@dimen/gastown_gutter_horizontal_padding_thin"
        android:layout_marginEnd="8dp"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintEnd_toEndOf="@+id/helper_snooze"
        app:layout_constraintStart_toStartOf="@+id/track"
        app:layout_constraintTop_toTopOf="@+id/track"
        style="@style/GastownAlarmFiringTrackTextStyle"/>
    <TextView
        android:textColor="?attr/colorOnSurface"
        android:gravity="end|center_vertical"
        android:id="@+id/dismiss_drag_target"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:minWidth="@dimen/google_min_touch_target_size"
        android:text="@string/alarm_alert_dismiss_text"
        android:paddingStart="8dp"
        android:paddingEnd="0dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="@dimen/gastown_gutter_horizontal_padding_thin"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintEnd_toEndOf="@+id/track"
        app:layout_constraintStart_toStartOf="@+id/helper_dismiss"
        app:layout_constraintTop_toTopOf="@+id/track"
        style="@style/GastownAlarmFiringTrackTextStyle"/>
    <ImageButton
        android:id="@+id/thumb"
        android:background="@drawable/gastown_alarm_activity_thumb_drawable"
        android:clickable="false"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/gastown_track_inset_thumb_margin"
        android:layout_marginBottom="@dimen/gastown_track_inset_thumb_margin"
        android:tint="?attr/colorOnPrimaryContainer"
        android:importantForAccessibility="no"
        android:backgroundTint="?attr/colorPrimaryContainer"
        app:layout_constraintBottom_toBottomOf="@+id/track"
        app:layout_constraintDimensionRatio="3:2"
        app:layout_constraintEnd_toEndOf="@+id/helper_thumb"
        app:layout_constraintStart_toStartOf="@+id/helper_thumb"
        app:layout_constraintTop_toTopOf="@+id/track"/>
</merge>
