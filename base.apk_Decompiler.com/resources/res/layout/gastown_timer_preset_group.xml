<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:orientation="horizontal">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_preset_1"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_preset_bottom_guideline"
        app:layout_constraintEnd_toStartOf="@+id/timer_preset_2"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TimerPresetButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_preset_2"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_preset_bottom_guideline"
        app:layout_constraintEnd_toStartOf="@+id/timer_preset_3"
        app:layout_constraintStart_toEndOf="@+id/timer_preset_1"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TimerPresetButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_preset_3"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginEnd="4dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_preset_bottom_guideline"
        app:layout_constraintEnd_toStartOf="@+id/timer_preset_4"
        app:layout_constraintStart_toEndOf="@+id/timer_preset_2"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TimerPresetButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/timer_preset_4"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@+id/timer_preset_bottom_guideline"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/timer_preset_3"
        app:layout_constraintTop_toTopOf="parent"
        style="@style/TimerPresetButtonStyle"/>
</merge>
