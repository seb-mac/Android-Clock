<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">
    <LinearLayout
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:id="@+id/buttons_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/gastown_stopwatch_buttons_container_margin_end"
        app:layout_constraintBottom_toTopOf="@+id/recycler_view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageButton
            android:id="@+id/previous_button"
            android:background="@drawable/gastown_stopwatch_nav_button_bg"
            android:padding="@dimen/gastown_stopwatch_nav_button_padding"
            android:visibility="gone"
            android:layout_width="@dimen/gastown_stopwatch_nav_button_size"
            android:layout_height="@dimen/gastown_stopwatch_nav_button_size"
            android:src="@drawable/gs_arrow_left_vd_theme_24"
            android:tint="@color/gastown_stopwatch_nav_icon_tint_selector"
            android:contentDescription="@string/sw_previous_lap_button"
            android:layout_marginEnd="@dimen/gastown_stopwatch_nav_button_margin_end"
            android:backgroundTint="@color/gastown_stopwatch_nav_bg_tint_selector"
            android:layout_marginVertical="@dimen/gastown_stopwatch_nav_button_margin_vertical"/>
        <ImageButton
            android:id="@+id/next_button"
            android:background="@drawable/gastown_stopwatch_nav_button_bg"
            android:padding="@dimen/gastown_stopwatch_nav_button_padding"
            android:visibility="gone"
            android:layout_width="@dimen/gastown_stopwatch_nav_button_size"
            android:layout_height="@dimen/gastown_stopwatch_nav_button_size"
            android:src="@drawable/gs_arrow_right_vd_theme_24"
            android:tint="@color/gastown_stopwatch_nav_icon_tint_selector"
            android:contentDescription="@string/sw_next_lap_button"
            android:backgroundTint="@color/gastown_stopwatch_nav_bg_tint_selector"
            android:layout_marginVertical="@dimen/gastown_stopwatch_nav_button_margin_vertical"/>
    </LinearLayout>
    <android.support.v7.widget.RecyclerView
        android:id="@+id/recycler_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/buttons_container"/>
</androidx.constraintlayout.widget.ConstraintLayout>
