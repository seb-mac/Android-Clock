<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/timer_card_state_titan_portrait">
    <Constraint android:id="@+id/timer_track">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toTopOf="@+id/track_button_divider"
            app:layout_constraintDimensionRatio="1:1"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintStart_toEndOf="@+id/timer_track_spacer"
            app:layout_constraintTop_toBottomOf="@+id/timer_label_spacer"
            app:layout_constraintVertical_bias="1"/>
    </Constraint>
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="0dp"
            android:layout_marginBottom="8dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_text"
            app:layout_constraintEnd_toEndOf="@+id/timer_text"
            app:layout_constraintStart_toStartOf="@+id/timer_text"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x11"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_start">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toStartOf="@+id/timer_text"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toStartOf="@+id/timer_text_spacer_end"
            app:layout_constraintHorizontal_weight="76"
            app:layout_constraintStart_toEndOf="@+id/timer_text_spacer_start"
            app:layout_constraintTop_toTopOf="@+id/timer_track"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text_spacer_end">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/timer_text"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintHorizontal_weight="12"
            app:layout_constraintStart_toEndOf="@+id/timer_text"
            app:layout_constraintTop_toTopOf="@+id/timer_text"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="48dp"
            android:layout_marginStart="8dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toStartOf="@+id/primary_button_spacer"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toEndOf="@+id/timer_track_spacer"
            app:layout_constraintTop_toBottomOf="@+id/track_button_divider"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintWidth_max="112dp"/>
    </Constraint>
    <Constraint android:id="@+id/primary_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginTop="48dp"
            android:layout_marginBottom="8dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintBottom_toTopOf="@+id/timer_track_spacer"
            app:layout_constraintDimensionRatio="H,1:1"
            app:layout_constraintEnd_toStartOf="@+id/tertiary_button_spacer"
            app:layout_constraintStart_toEndOf="@+id/primary_button_spacer"
            app:layout_constraintTop_toBottomOf="@+id/track_button_divider"
            app:layout_constraintVertical_bias="0"
            app:layout_constraintWidth_max="112dp"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/primary_button_spacer">
        <Layout
            android:layout_width="24dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/track_button_divider"
            app:layout_constraintEnd_toStartOf="@+id/primary_button"
            app:layout_constraintStart_toEndOf="@+id/play_pause"
            app:layout_constraintTop_toBottomOf="@+id/track_button_divider"/>
    </Constraint>
    <Constraint android:id="@+id/secondary_button">
        <Layout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintBottom_toBottomOf="@+id/timer_track"
            app:layout_constraintDimensionRatio="W,1:1"
            app:layout_constraintEnd_toEndOf="@+id/timer_track"
            app:layout_constraintStart_toStartOf="@+id/timer_track"
            app:layout_constraintTop_toBottomOf="@+id/timer_text"
            app:layout_constraintVertical_bias="0.2"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/tertiary_button">
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
</ConstraintSet>
