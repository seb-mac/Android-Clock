<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/guideline_button_center"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintGuide_percent="0.5"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/button_top"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_track_top_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="horizontal"
        android:id="@+id/button_bottom"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_track_bottom_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/button_gutter_left"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_left_percent"/>
    <androidx.constraintlayout.widget.Guideline
        android:orientation="vertical"
        android:id="@+id/button_gutter_right"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintGuide_percent="@fraction/gastown_alarm_activity_gutter_right_percent"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="24sp"
        android:textColor="?attr/colorOnTertiaryContainer"
        android:gravity="center"
        android:id="@+id/button_tap_snooze"
        android:padding="16dp"
        android:visibility="invisible"
        android:minWidth="@dimen/google_min_touch_target_size"
        android:text="@string/alarm_alert_snooze_text"
        android:maxLines="1"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginEnd="1dp"
        app:backgroundTint="?attr/colorTertiaryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/guideline_button_center"
        app:layout_constraintHorizontal_bias="1"
        app:layout_constraintStart_toStartOf="@+id/button_gutter_left"
        app:layout_constraintTop_toTopOf="@+id/button_top"
        app:layout_constraintVertical_bias="0"
        style="@style/GastownAlarmFiringButtonStyle"/>
    <com.google.android.material.button.MaterialButton
        android:textSize="24sp"
        android:textColor="?attr/colorOnSecondaryContainer"
        android:gravity="center"
        android:id="@+id/button_tap_dismiss"
        android:padding="16dp"
        android:visibility="invisible"
        android:minWidth="@dimen/google_min_touch_target_size"
        android:text="@string/alarm_alert_dismiss_text"
        android:maxLines="1"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        android:layout_marginStart="1dp"
        app:backgroundTint="?attr/colorSecondaryContainer"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/button_gutter_right"
        app:layout_constraintHorizontal_bias="0"
        app:layout_constraintStart_toStartOf="@+id/guideline_button_center"
        app:layout_constraintTop_toTopOf="@+id/button_top"
        app:layout_constraintVertical_bias="0"
        style="@style/GastownAlarmFiringButtonStyle"/>
</merge>
