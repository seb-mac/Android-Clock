<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <android.support.v7.widget.RecyclerView
        android:scrollbarStyle="outsideOverlay"
        android:id="@+id/card_view"
        android:paddingBottom="16dp"
        android:visibility="gone"
        android:scrollbars="vertical"
        android:saveEnabled="false"
        android:clipToPadding="false"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:paddingHorizontal="@dimen/fragment_recycler_view_padding_horizontal"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/bedtime_clock"
        style="@style/BedtimeFragmentRecyclerViewStyle"/>
    <ScrollView
        android:id="@+id/bedtime_onboarding_intro"
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:fadeScrollbars="false">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/start_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_start_percent"/>
            <androidx.constraintlayout.widget.Guideline
                android:orientation="vertical"
                android:id="@+id/end_guide"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:layout_constraintGuide_percent="@fraction/bedtime_onboarding_intro_horizontal_end_percent"/>
            <TextView
                android:textSize="24sp"
                android:textColor="?attr/colorOnBackground"
                android:gravity="center"
                android:id="@+id/bedtime_onboarding_intro_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bedtime_onboarding_intro_title"
                app:layout_constraintBottom_toTopOf="@+id/bedtime_onboarding_intro_description"
                app:layout_constraintEnd_toEndOf="@+id/end_guide"
                app:layout_constraintStart_toStartOf="@+id/start_guide"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_chainStyle="spread"/>
            <TextView
                android:textSize="16sp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:gravity="center"
                android:id="@+id/bedtime_onboarding_intro_description"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bedtime_onboarding_intro_description"
                android:fontFamily="@font/google_sans_medium_compat"
                app:layout_constraintBottom_toTopOf="@+id/bedtime_onboarding_graphic"
                app:layout_constraintEnd_toEndOf="@+id/end_guide"
                app:layout_constraintStart_toStartOf="@+id/start_guide"
                app:layout_constraintTop_toBottomOf="@+id/bedtime_onboarding_intro_title"/>
            <ImageView
                android:id="@+id/bedtime_onboarding_graphic"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_marginTop="4dp"
                android:scaleType="centerInside"
                android:importantForAccessibility="no"
                app:layout_constraintBottom_toTopOf="@+id/bedtime_onboarding_start"
                app:layout_constraintDimensionRatio="@string/bedtime_onboarding_graphic_ratio"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHeight_max="@dimen/bedtime_onboarding_graphic_height_max"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bedtime_onboarding_intro_description"
                app:layout_constraintWidth_max="@dimen/bedtime_onboarding_graphic_width_max"/>
            <ImageView
                android:id="@+id/start_bedtime_animation"
                android:visibility="gone"
                android:layout_width="@dimen/google_min_touch_target_size"
                android:layout_height="@dimen/google_min_touch_target_size"
                android:src="@drawable/gs_play_circle_vd_theme_24"
                android:tint="?attr/colorOnSurface"
                android:contentDescription="@string/resume_animation_content_description"
                android:translationY="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/bedtime_onboarding_graphic"
                app:layout_constraintEnd_toEndOf="@+id/bedtime_onboarding_graphic"/>
            <Button
                android:id="@+id/bedtime_onboarding_start"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="4dp"
                android:text="@string/bedtime_onboarding_intro_button"
                android:textAllCaps="false"
                android:fontFamily="@font/google_sans_medium_compat"
                android:paddingVertical="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/bedtime_onboarding_graphic"/>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
