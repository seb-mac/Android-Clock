<?xml version="1.0" encoding="utf-8"?>
<ConstraintSet xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/gastown_timer_card_state_deskclock_lock_screen">
    <Constraint android:id="@+id/timer_background">
        <PropertySet android:visibility="gone"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track">
        <PropertySet android:visibility="gone"/>
    </Constraint>
    <Constraint android:id="@+id/timer_track_expired">
        <PropertySet android:visibility="gone"/>
    </Constraint>
    <Constraint android:id="@+id/timer_label">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/expired_bottom_timer_label_guideline"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/expired_top_timer_label_guideline"/>
        <CustomAttribute
            app:attributeName="gravity"
            app:customIntegerValue="0x11"/>
        <CustomAttribute
            app:attributeName="textSize"
            app:customFloatValue="32"/>
    </Constraint>
    <Constraint android:id="@+id/timer_text">
        <Layout
            android:layout_width="0dp"
            android:layout_height="0dp"
            app:layout_constraintBottom_toBottomOf="@+id/expired_bottom_timer_text_guideline"
            app:layout_constraintDimensionRatio="5:2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/expired_top_timer_text_guideline"/>
    </Constraint>
    <Constraint android:id="@+id/reset_button">
        <Layout
            android:layout_width="@dimen/timer_card_expired_button_width"
            android:layout_height="@dimen/timer_card_expired_button_height"
            android:maxWidth="@dimen/timer_card_expired_button_max_width"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="4dp"
            app:layout_constraintBottom_toBottomOf="@+id/add_one_min_button"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/add_one_min_button"
            app:layout_constraintTop_toTopOf="@+id/add_one_min_button"/>
    </Constraint>
    <Constraint android:id="@+id/add_one_min_button">
        <Layout
            android:layout_width="@dimen/timer_card_expired_button_width"
            android:layout_height="@dimen/timer_card_expired_button_height"
            android:layout_marginBottom="30dp"
            android:maxWidth="@dimen/timer_card_expired_button_max_width"
            android:layout_marginStart="4dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/reset_button"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintHorizontal_chainStyle="packed"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/expired_button_top_guideline"/>
        <PropertySet app:visibilityMode="ignore"/>
    </Constraint>
    <Constraint android:id="@+id/play_pause_button">
        <PropertySet android:visibility="gone"/>
    </Constraint>
    <Constraint android:id="@+id/delete_button">
        <PropertySet android:visibility="gone"/>
    </Constraint>
</ConstraintSet>
