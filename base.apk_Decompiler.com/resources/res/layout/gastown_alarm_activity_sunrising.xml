<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto">
    <com.android.deskclock.widget.NoScrollView
        android:id="@+id/sunrise_scroll_view"
        android:background="#f2bd42"
        android:scrollbars="none"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintLeft_toLeftOf="parent"
        app:layout_constraintRight_toRightOf="parent"
        app:layout_constraintTop_toTopOf="parent">
        <ImageView
            android:id="@+id/sunrise_image_view"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scaleType="fitCenter"
            android:adjustViewBounds="true"
            android:importantForAccessibility="no"/>
    </com.android.deskclock.widget.NoScrollView>
    <com.google.android.material.button.MaterialButton
        android:textColor="@color/black_50"
        android:gravity="center"
        android:id="@+id/predismiss"
        android:padding="24dp"
        android:visibility="invisible"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/alarm_alert_predismiss_text"
        android:singleLine="true"
        android:insetLeft="0dp"
        android:insetRight="0dp"
        android:insetTop="0dp"
        android:insetBottom="0dp"
        app:backgroundTint="@android:color/white"
        app:layout_constraintBottom_toBottomOf="@+id/button_bottom"
        app:layout_constraintLeft_toLeftOf="@+id/gutter_left"
        app:layout_constraintRight_toRightOf="@+id/gutter_right"
        app:layout_constraintTop_toTopOf="@+id/button_top"
        style="@style/TextAppearance.LabelThin.AlarmActivity"/>
</merge>
